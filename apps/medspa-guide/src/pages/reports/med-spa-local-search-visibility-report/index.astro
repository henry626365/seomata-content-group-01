---
import PageShell from '../../../layouts/PageShell.astro';

const seoTitle = 'Med Spa Local Search Visibility — Method primer (phase 1)';
const seoDesc =
	'A methodology dossier emphasizing qualitative inventories & hypothesis logs—no leaderboard tables or fabricated benchmarking.';
---

<PageShell title={seoTitle} description={seoDesc}>
	<h1>Phase-1 local search visibility methodology</h1>
	<p>
		This document frames how internal teams can narrate demand capture without invoking numerical promises. Outputs are
		<strong>reflection artifacts</strong>
		not investor-grade audited statements.
	</p>
	<h2>Sections to maintain internally</h2>
	<ol>
		<li><strong>Entity narrative:</strong>
			paragraph history of rebrands & provider roster shifts affecting listings.</li>
		<li><strong>Signals inventory:</strong>
			not “scores”—qualitative notes across GBP completeness, citation parity, onsite routing clarity.</li>
		<li><strong>Inquiry journaling:</strong>
			de-identified anecdotes from coordinators summarizing thematic friction.</li>
		<li><strong>Falsifiable experiments backlog:</strong>
			e.g., rewrite hero modality ordering for four weeks hypothesizing CTR lift—document invalidation pathways too.</li>
	</ol>
	<h2>Explicit exclusions</h2>
	<ul>
		<li>No fabricated impression share deltas.</li>
		<li>No scraped competitor dossiers scraped en masse from platforms.</li>
		<li>No medical outcome correlation claims.</li>
	</ul>
</PageShell>
