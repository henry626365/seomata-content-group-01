---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import ArticleCard from '../../components/home/ArticleCard.astro';
import SiteFooter from '../../components/home/SiteFooter.astro';

const seoTitle = 'Marketing Guides Archive | Med Spa Marketing Guide';
const seoDesc =
	'Operational SEO, GBP, modality pages, reputation, and conversion workflows for aesthetic practices—education only (not medical/legal advice).';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={seoTitle} description={seoDesc} />
	</head>
	<body class="archive-body">
		<Header />
		<main class="archive-main">
			<header class="page-intro">
				<h1 id="guides">Guides archive</h1>
				<p>
					Timeless checklists covering local discovery, modality landing pages, review operations, and
					consultation capture. Content is directional—not a substitute for HIPAA counsel, clinician oversight,
					or platform policy review.
				</p>
			</header>
			<div class="grid">
				{
					posts.map((post) => (
						<ArticleCard
							href={`/blog/${post.id}/`}
							title={post.data.title}
							description={post.data.description}
							image={
								post.data.heroImage?.src ??
								post.data.heroPhoto ??
								'/images/med-spa-seo-checklist-preview.svg'
							}
							imageAlt={post.data.title}
							category={post.data.category}
						/>
					))
				}
			</div>
		</main>
		<SiteFooter />
	</body>
</html>

<style>
	.archive-body {
		margin: 0;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		background: linear-gradient(180deg, #f4f9fc 0%, #f0f4f7 40%, #ffffff 100%);
		color: #1c3a4d;
	}
	.archive-main {
		flex: 1;
		width: min(1180px, calc(100% - clamp(1.25rem, 5vw, 3rem)));
		margin: 0 auto;
		padding: clamp(1.5rem, 4vw, 2.5rem) 0 clamp(2.75rem, 6vw, 4rem);
	}
	.page-intro {
		margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
	}
	.page-intro h1 {
		margin: 0 0 0.85rem;
		font-size: clamp(1.5rem, 3vw, 2rem);
		color: #0b3555;
		letter-spacing: -0.03em;
	}
	.page-intro p {
		margin: 0;
		max-width: 68ch;
		line-height: 1.72;
		color: #395f78;
		font-size: clamp(0.96rem, 1.45vw, 1.06rem);
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.2rem;
		align-items: stretch;
	}
	@media (max-width: 1024px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 660px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
