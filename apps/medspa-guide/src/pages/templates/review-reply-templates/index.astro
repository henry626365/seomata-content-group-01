---
import PageShell from '../../../layouts/PageShell.astro';

const seoTitle = 'Review Reply Template Pack | Med Spa Marketing Guide';
const seoDesc =
	'Draft scaffolding for ecstatic, nuanced, dissatisfied patient reviews—finalize with HIPAA counsel prior to publishing.';
---

<PageShell title={seoTitle} description={seoDesc}>
	<h1>Review reply template pack</h1>
	<p>
		Keep replies short, appreciative, HIPAA-safe—never clinically debate in public forums. Customize voice for brand tonality.
	</p>
	<h2>Warm-positive</h2>
	<blockquote>
		“We’re thankful you entrusted our team—{' '}
		<code>[modality/context]</code>
		journeys hinge on teamwork. Warmly inviting you back for future skin health check-ins.”
	</blockquote>
	<h2>Constructively mixed</h2>
	<blockquote>
		“We hear your experience matters more than optics; we’d value continuing privately at{' '}
		<code>[secure channel]</code>
		{' '}
		to ensure follow-up.”
	</blockquote>
	<h2>Urgent dissatisfied</h2>
	<blockquote>
		“Our leadership will prioritize understanding your concerns—please expect outreach through{' '}
		<code>[designated liaison]</code>
		{' '}
		within [SLA span]. Patient safety anchors every response.”
	</blockquote>
</PageShell>
