---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import SiteFooter from '../components/home/SiteFooter.astro';
import HomeHero from '../components/home/HomeHero.astro';
import FeaturedGuideGrid from '../components/home/FeaturedGuideGrid.astro';
import SectionHeader from '../components/home/SectionHeader.astro';
import ArticleCard from '../components/home/ArticleCard.astro';
import { HOME_META_DESCRIPTION, HOME_META_TITLE } from '../consts';
import { resolveHeroThumbnail } from '../utils/publicAsset';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const byId = new Map(posts.map((p) => [p.id, p]));

function thumbFor(postId: string, fallback: string): string {
	const p = byId.get(postId);
	return resolveHeroThumbnail(p?.data.heroImage?.src, p?.data.heroPhoto, fallback);
}

const featuredGuide = {
	href: '/blog/med-spa-local-seo-checklist/',
	title: 'Med Spa Local SEO Checklist',
	description:
		'A first-pass audit for the pieces that usually decide whether local search turns into a serious consultation: GBP, service pages, reviews, and booking paths.',
	image: thumbFor('med-spa-local-seo-checklist', '/images/med-spa-seo-checklist-preview.svg'),
	imageAlt: 'Local SEO checklist preview for aesthetic practices',
	category: 'Start here',
};

const featuredSide = [
	{
		href: '/blog/google-business-profile-med-spa-seo/',
		title: 'Google Business Profile Optimization',
		description:
			'Profile fields, photos, services, and review signals that should match the clinic patients will actually visit.',
		image: thumbFor('google-business-profile-med-spa-seo', '/images/med-spa-google-maps-visibility.svg'),
		imageAlt: 'Google Maps visibility illustration',
		category: 'Maps',
	},
	{
		href: '/blog/botox-seo-strategy/',
		title: 'Botox SEO Strategy',
		description:
			'A treatment-page structure for injectables that balances search intent, provider proof, and consultation boundaries.',
		image: thumbFor('botox-seo-strategy', '/images/med-spa-service-page-wireframe.svg'),
		imageAlt: 'Botox service page structure',
		category: 'Service pages',
	},
	{
		href: '/blog/med-spa-review-seo/',
		title: 'Med Spa Review SEO',
		description:
			'How to treat reviews as patient feedback, public trust evidence, and a source of page-level improvements.',
		image: thumbFor('med-spa-review-seo', '/images/med-spa-consultation-funnel.svg'),
		imageAlt: 'Review workflow illustration',
		category: 'Reputation',
	},
	{
		href: '/blog/med-spa-seo-conversion-rate/',
		title: 'Med Spa SEO Conversion',
		description:
			'What to inspect when the site has traffic but visitors are not becoming useful calls, forms, or bookings.',
		image: thumbFor('med-spa-seo-conversion-rate', '/images/med-spa-consultation-funnel.svg'),
		imageAlt: 'Consultation conversion funnel',
		category: 'Conversion',
	},
];

const clinicQuestions = [
	{
		question: 'We are not visible in local search.',
		answer:
			'Start with GBP categories, service labels, location consistency, review recency, and whether the site has a real page for each important treatment.',
		href: '/local-seo/',
		label: 'Local SEO hub',
	},
	{
		question: 'Our Google Maps profile looks active, but calls are weak.',
		answer:
			'Check whether photos, reviews, services, Q&A, and website links all lead to a confident next step for a nearby patient.',
		href: '/google-maps/',
		label: 'Maps guide',
	},
	{
		question: 'Our treatment pages read like everyone else.',
		answer:
			'Rewrite around patient concern, candidacy, provider proof, process, FAQs, and consultation language instead of repeating service definitions.',
		href: '/service-pages/',
		label: 'Service pages',
	},
	{
		question: 'Traffic is growing, but consult quality is unclear.',
		answer:
			'Separate calls, forms, online bookings, abandoned forms, and booked consults before deciding the website is working.',
		href: '/website-conversion/',
		label: 'Conversion hub',
	},
];

const editorialFramework = [
	{
		title: 'Local proof',
		body: 'The clinic must feel physically real: accurate profile data, current photos, location context, and review language that matches the services being promoted.',
	},
	{
		title: 'Treatment clarity',
		body: 'Pages should explain who typically asks about a service, what a consultation determines, and which adjacent services a patient may compare.',
	},
	{
		title: 'Trust before action',
		body: 'Credentials, expectations, risks, FAQs, and tone need to appear before aggressive booking prompts, especially for elective procedures.',
	},
	{
		title: 'Measured inquiry',
		body: 'Rankings and visits matter less than calls, forms, bookings, and whether the inquiries are specific enough for the front desk to handle well.',
	},
];

const pillarCards = [
	{
		href: '/local-seo/',
		title: 'Local Search Visibility',
		description: 'A diagnostic for GBP, city intent, service-to-page alignment, reviews, and consultation routes.',
		image: '/images/home-diagnostic-local-search.webp',
		imageAlt: 'Med spa local search audit materials on a desk',
		category: 'Diagnostic hub',
	},
	{
		href: '/google-maps/',
		title: 'Google Maps Operations',
		description: 'Monthly profile maintenance for categories, services, photos, Q&A, review themes, and tracking links.',
		image: '/images/home-diagnostic-google-maps.webp',
		imageAlt: 'Map profile operation notes for a med spa',
		category: 'Operations',
	},
	{
		href: '/service-pages/',
		title: 'Aesthetic Service Pages',
		description: 'A section-by-section editing approach for treatment pages that need both trust and search visibility.',
		image: '/images/home-diagnostic-service-pages.webp',
		imageAlt: 'Service page planning materials for aesthetic treatments',
		category: 'Page structure',
	},
	{
		href: '/patient-reviews/',
		title: 'Patient Reviews & Reputation',
		description: 'Review request timing, response tone, onsite trust signals, and feedback themes for page updates.',
		image: '/images/home-diagnostic-reviews.webp',
		imageAlt: 'Review workflow cards for med spa reputation planning',
		category: 'Trust',
	},
];

const toolCards = [
	{
		href: '/templates/med-spa-seo-checklist/',
		title: 'Med Spa SEO Checklist',
		description: 'A recurring worksheet for checking entity consistency, service pages, reviews, and consult paths.',
		image: '/images/home-tool-seo-checklist.webp',
		imageAlt: 'Med spa SEO checklist worksheet on an editorial desk',
		category: 'Template',
	},
	{
		href: '/templates/consultation-cta-examples/',
		title: 'Consultation CTA Examples',
		description: 'CTA examples organized by patient certainty, treatment complexity, and booking friction.',
		image: '/images/home-tool-consultation-cta.webp',
		imageAlt: 'Consultation CTA planning cards and booking path notes',
		category: 'Template',
	},
	{
		href: '/case-breakdowns/med-spa-website-conversion-breakdown/',
		title: 'Traffic Without Consultations',
		description: 'An editorial teardown format for separating observation, likely friction, evidence, and testable edits.',
		image: '/images/home-tool-conversion-teardown.webp',
		imageAlt: 'Website conversion teardown notes and analytics cards',
		category: 'Breakdown',
	},
];

const latestIds = [
	'med-spa-seo-content-quality',
	'med-spa-seo-common-mistakes',
	'med-spa-seo-for-competitive-cities',
	'med-spa-seo-for-small-cities',
	'med-spa-seo-for-high-income-markets',
	'med-spa-seo-for-memberships',
];

const latestFallbackCopy: Record<string, string> = {
	'med-spa-seo-content-quality':
		'How to spot thin treatment content, replace generic claims, and make pages feel reviewed by someone who understands the clinic.',
	'med-spa-seo-common-mistakes':
		'Mistakes that quietly weaken appointment intent: duplicate city pages, vague services, buried proof, and unclear next steps.',
	'med-spa-seo-for-competitive-cities':
		'How to compete when every local result is crowded and every treatment page needs stronger specificity.',
	'med-spa-seo-for-small-cities':
		'How smaller markets can win with service clarity, real local proof, and disciplined page choices.',
	'med-spa-seo-for-high-income-markets':
		'Search strategy for markets where clicks are expensive and trust expectations are high before a patient ever books.',
	'med-spa-seo-for-memberships':
		'How to explain membership value without making recurring treatment feel like a generic subscription pitch.',
};

const latest = latestIds
	.map((id) => {
		const post = byId.get(id);
		if (!post) return undefined;
		return {
			href: `/blog/${post.id}/`,
			title: post.data.title,
			description: latestFallbackCopy[id] ?? post.data.description,
			image: resolveHeroThumbnail(
				post.data.heroImage?.src,
				post.data.heroPhoto,
				'/images/med-spa-seo-checklist-preview.svg',
			),
			imageAlt: post.data.title,
			category: post.data.category,
		};
	})
	.filter(Boolean);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={HOME_META_TITLE} description={HOME_META_DESCRIPTION} />
	</head>
	<body class="home-body">
		<Header />
		<main class="home-main">
			<HomeHero
				title="Med spa search growth needs proof, not more generic pages"
				subtitle="An editorial field guide for aesthetic practices working on Google Maps visibility, treatment-page trust, patient reviews, and consultation conversion."
				primaryLabel="Run the local SEO checklist"
				primaryHref="/blog/med-spa-local-seo-checklist/"
				secondaryLabel="Choose a diagnostic hub"
				secondaryHref="/local-seo/"
				featuredImage="/images/home-med-spa-editorial-workspace.webp"
				featuredImageAlt="Editorial med spa search audit workspace with map and service notes"
			/>

			<section class="editorial-panel">
				<div>
					<p class="panel-kicker">Editorial position</p>
					<h2>Most med spa SEO problems are not only SEO problems.</h2>
				</div>
				<p>
					A clinic can have pages indexed, a live GBP profile, and a blog archive, yet still fail to earn
					confident consultations. The missing pieces are usually operational: inconsistent service naming,
					thin treatment explanations, vague proof, weak review workflows, or a booking path that asks too
					much before trust is built.
				</p>
			</section>

			<section class="segment">
				<SectionHeader
					title="Start with the clinic question"
					description="These are the questions a real operator usually brings to a review meeting. Each one points to a different kind of work."
				/>
				<div class="question-grid">
					{
						clinicQuestions.map((item, i) => (
							<article class="question-card">
								<span class="question-index">Q{String(i + 1).padStart(2, '0')}</span>
								<h3>{item.question}</h3>
								<p>{item.answer}</p>
								<a href={item.href}>{item.label}</a>
							</article>
						))
					}
				</div>
			</section>

			<section class="segment">
				<SectionHeader
					title="Featured editing guides"
					description="These are intentionally practical: use them while auditing a page, profile, or consult path."
				/>
				<FeaturedGuideGrid featured={featuredGuide} items={featuredSide} />
			</section>

			<section class="segment framework-section">
				<SectionHeader
					title="The editorial framework"
					description="Every recommendation on this site should connect to one of these four checks."
				/>
				<div class="framework-grid">
					{
						editorialFramework.map((item, i) => (
							<article class="framework-card">
								<span>{String(i + 1).padStart(2, '0')}</span>
								<h3>{item.title}</h3>
								<p>{item.body}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="segment">
				<SectionHeader
					title="Diagnostic hubs"
					description="Choose the hub that matches the bottleneck. The pages are built as field notes, not keyword folders."
				/>
				<div class="card-grid">
					{pillarCards.map((p) => <ArticleCard {...p} variant="homeResource" />)}
				</div>
			</section>

			<section class="segment methods-panel">
				<div class="method-copy">
					<p class="panel-kicker">How to use the site</p>
					<h2>Read less, inspect more.</h2>
					<p>
						Pick one service line or location, then trace the path from search result to profile, page, CTA,
						form, and follow-up. The best edit is usually the one that makes the next patient decision easier
						to understand.
					</p>
				</div>
				<ul class="method-list">
					<li>Separate observed facts from assumptions.</li>
					<li>Write down what evidence would confirm the problem.</li>
					<li>Assign the smallest useful edit before planning a rebuild.</li>
					<li>Measure calls, forms, bookings, and lead quality separately.</li>
				</ul>
			</section>

			<section class="segment">
				<SectionHeader
					title="Templates, reports, and teardowns"
					description="Tools for teams that need a concrete artifact at the end of the review."
				/>
				<div class="card-grid tri">
					{toolCards.map((t) => <ArticleCard {...t} variant="homeResource" />)}
				</div>
			</section>

			<section class="segment">
				<SectionHeader
					title="Recent editor picks"
					description="A short list of newer guides worth reading when quality, competition, or conversion is the current concern."
				/>
				<div class="card-grid">
					{latest.map((item) => item && <ArticleCard {...item} variant="homeResource" />)}
				</div>
				<p class="more-guides">
					<a class="text-link" href="/blog/">Browse the full guide archive</a>
				</p>
			</section>
		</main>
		<SiteFooter />
	</body>
</html>

<style>
	.home-body {
		margin: 0;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		background: linear-gradient(180deg, #f4f9fc 0%, #f0f4f7 35%, #ffffff 100%);
		color: #1c3a4d;
		overflow-x: clip;
	}

	.home-main {
		flex: 1;
		width: min(1180px, calc(100% - clamp(1.5rem, 5vw, 3rem)));
		margin: 0 auto;
		padding: clamp(1.25rem, 3vw, 1.75rem) 0 clamp(2rem, 5vw, 3.25rem);
		display: grid;
		gap: clamp(1.75rem, 4vw, 2.75rem);
	}

	.segment,
	.editorial-panel {
		background: #fff;
		border: 1px solid rgba(209, 222, 234, 0.95);
		border-radius: 22px;
		padding: clamp(1.5rem, 3.5vw, 2.25rem) clamp(1.25rem, 3.5vw, 2rem);
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.8) inset,
			0 10px 40px rgba(11, 53, 85, 0.05);
	}

	.editorial-panel,
	.methods-panel {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
		gap: clamp(1.25rem, 4vw, 2.25rem);
		align-items: start;
	}

	.panel-kicker {
		margin: 0 0 0.4rem;
		color: #a26d35;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.editorial-panel h2,
	.methods-panel h2 {
		margin: 0;
		color: #0b3555;
		font-size: clamp(1.35rem, 3vw, 1.95rem);
		line-height: 1.18;
		letter-spacing: -0.03em;
	}

	.editorial-panel > p,
	.method-copy p {
		margin: 0;
		color: #385f78;
		font-size: clamp(0.98rem, 1.5vw, 1.05rem);
		line-height: 1.72;
	}

	.method-copy p {
		margin-top: 0.75rem;
	}

	.question-grid,
	.framework-grid,
	.card-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.25rem;
		align-items: stretch;
	}

	.question-card,
	.framework-card {
		border: 1px solid #d2dfeb;
		border-radius: 16px;
		padding: 1rem 1.05rem;
		background: linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);
		transition:
			border-color 0.2s ease,
			box-shadow 0.22s ease,
			transform 0.22s ease;
	}

	.question-card:hover,
	.framework-card:hover {
		border-color: #9ec4e8;
		box-shadow: 0 10px 28px rgba(11, 53, 85, 0.075);
		transform: translateY(-2px);
	}

	.question-index {
		display: inline-block;
		margin-bottom: 0.6rem;
		color: #a26d35;
		font-size: 0.72rem;
		font-weight: 850;
		letter-spacing: 0.1em;
	}

	.question-card h3,
	.framework-card h3 {
		margin: 0 0 0.55rem;
		color: #0b3555;
		font-size: clamp(1.05rem, 1.25vw, 1.16rem);
		line-height: 1.26;
		font-weight: 800;
		transition: color 0.2s ease;
	}

	.question-card p,
	.framework-card p {
		margin: 0;
		color: #4a6b82;
		font-size: clamp(0.92rem, 1.05vw, 0.98rem);
		line-height: 1.64;
		transition: color 0.2s ease;
	}

	.question-card a {
		display: inline-flex;
		margin-top: 0.85rem;
		color: #0b4f7a;
		font-size: 0.88rem;
		font-weight: 800;
		text-decoration: none;
		border-bottom: 2px solid #d4a574;
	}

	.question-card:hover h3,
	.question-card:hover p,
	.question-card:hover a,
	.framework-card:hover h3,
	.framework-card:hover p {
		color: #0b63b6;
	}

	.framework-card span {
		display: inline-block;
		margin-bottom: 0.6rem;
		color: #a26d35;
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.08em;
	}

	.card-grid.tri {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.method-list {
		margin: 0;
		padding-left: 1.2rem;
		display: grid;
		gap: 0.55rem;
		color: #365f78;
		line-height: 1.65;
	}

	.method-list li::marker {
		color: #d4a574;
	}

	.more-guides {
		margin: 1.35rem 0 0;
		text-align: center;
	}

	.text-link {
		font-weight: 700;
		color: #0b3555;
		text-decoration: none;
		border-bottom: 2px solid #d4a574;
		padding-bottom: 0.08rem;
	}

	.text-link:hover {
		color: #072a43;
	}

	@media (max-width: 1100px) {
		.question-grid,
		.framework-grid,
		.card-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.card-grid.tri {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 760px) {
		.editorial-panel,
		.methods-panel {
			grid-template-columns: 1fr;
		}

		.question-grid,
		.framework-grid,
		.card-grid,
		.card-grid.tri {
			grid-template-columns: 1fr;
		}
	}
</style>
