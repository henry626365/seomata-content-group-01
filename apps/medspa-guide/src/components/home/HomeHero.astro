---
import EyebrowLabel from './EyebrowLabel.astro';

type Props = {
	title: string;
	subtitle: string;
	primaryLabel: string;
	primaryHref: string;
	secondaryLabel: string;
	secondaryHref: string;
	eyebrow?: string;
	featuredImage?: string;
	featuredImageAlt?: string;
};

const {
	title,
	subtitle,
	primaryLabel,
	primaryHref,
	secondaryLabel,
	secondaryHref,
	eyebrow = 'Med Spa Marketing Guide',
	featuredImage = '/images/med-spa-seo-checklist-preview.svg',
	featuredImageAlt = 'Illustrative marketing checklist visualization for aesthetic practices'
} = Astro.props;
---

<section class="home-hero">
	<div class="hero-layout">
		<div class="hero-copy">
			<EyebrowLabel text={eyebrow} />
			<h1>{title}</h1>
			<p class="lead">{subtitle}</p>
			<div class="actions">
				<a class="btn primary" href={primaryHref}>{primaryLabel}</a>
				<a class="btn secondary" href={secondaryHref}>{secondaryLabel}</a>
			</div>
		</div>
		<a class="hero-visual" href={primaryHref}>
			<div class="hero-visual-inner">
				<img src={featuredImage} alt={featuredImageAlt} loading="eager" width="640" height="400" />
			</div>
		</a>
	</div>
</section>

<style>
	.home-hero {
		background: linear-gradient(145deg, #f3f8fc 0%, #ffffff 55%, #f1f6fb 100%);
		border: 1px solid #c5dce8;
		border-radius: 24px;
		padding: clamp(1.5rem, 4vw, 2.5rem) clamp(1.25rem, 3vw, 2.5rem);
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.85) inset,
			0 12px 40px rgba(11, 53, 85, 0.08),
			0 2px 8px rgba(11, 53, 85, 0.04);
	}
	.hero-layout {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		gap: clamp(1.5rem, 4vw, 2.75rem);
		align-items: center;
	}
	h1 {
		margin: 0 0 0.85rem;
		font-size: clamp(1.7rem, 4vw, 2.55rem);
		line-height: 1.18;
		color: #0b3555;
		font-weight: 700;
		max-width: 22ch;
	}
	.lead {
		margin: 0 0 1.35rem;
		max-width: 42ch;
		font-size: clamp(0.98rem, 1.6vw, 1.08rem);
		line-height: 1.65;
		color: #325a72;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 0.85rem;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.72rem 1.2rem;
		border-radius: 11px;
		font-weight: 600;
		font-size: 0.94rem;
		text-decoration: none;
		transition:
			background 0.18s ease,
			border-color 0.18s ease,
			transform 0.18s ease,
			box-shadow 0.18s ease;
	}
	.btn:active {
		transform: scale(0.98);
	}
	.primary {
		background: #0b3555;
		color: #fff;
		border: 1px solid #0b3555;
		box-shadow: 0 4px 14px rgba(11, 53, 85, 0.22);
	}
	.primary:hover {
		background: #072a43;
		box-shadow: 0 6px 20px rgba(11, 53, 85, 0.28);
	}
	.secondary {
		background: rgba(255, 255, 255, 0.95);
		color: #0b3555;
		border: 1px solid #b3cfe0;
	}
	.secondary:hover {
		background: #fff;
		border-color: #2f80ed;
	}
	.hero-visual {
		display: block;
		text-decoration: none;
		color: inherit;
		border-radius: 20px;
		transition: transform 0.22s ease;
	}
	.hero-visual:hover {
		transform: translateY(-3px);
	}
	.hero-visual:focus-visible {
		outline: 2px solid #2f80ed;
		outline-offset: 4px;
		border-radius: 22px;
	}
	.hero-visual-inner {
		border-radius: 20px;
		overflow: hidden;
		background: #fff;
		border: 1px solid #d1e6f2;
		box-shadow:
			0 16px 48px rgba(11, 53, 85, 0.12),
			0 4px 12px rgba(11, 53, 85, 0.06);
		aspect-ratio: 4 / 3;
	}
	.hero-visual-inner img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	@media (max-width: 960px) {
		.hero-layout {
			grid-template-columns: 1fr;
		}
		h1 {
			max-width: none;
		}
		.lead {
			max-width: none;
			margin-inline: auto;
			text-align: center;
		}
		.hero-copy {
			text-align: center;
		}
		.actions {
			justify-content: center;
		}
		.hero-visual {
			max-width: 520px;
			margin-inline: auto;
			width: 100%;
		}
	}
</style>
