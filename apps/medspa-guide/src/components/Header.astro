---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav class="nav-bar" aria-label="Primary">
		<a class="brand" href="/">{SITE_TITLE}</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/local-seo/">Local SEO</HeaderLink>
			<HeaderLink href="/google-maps/">Maps</HeaderLink>
			<HeaderLink href="/service-pages/">Services</HeaderLink>
			<HeaderLink href="/patient-reviews/">Reviews</HeaderLink>
			<HeaderLink href="/website-conversion/">Conversion</HeaderLink>
			<HeaderLink href="/templates/">Templates</HeaderLink>
			<HeaderLink href="/case-breakdowns/">Breakdowns</HeaderLink>
			<HeaderLink href="/reports/">Reports</HeaderLink>
			<HeaderLink href="/blog/">Guides</HeaderLink>
			<HeaderLink href="/about/">About</HeaderLink>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(255, 255, 255, 0.92);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid rgba(14, 59, 86, 0.08);
		box-shadow: 0 6px 24px rgba(11, 53, 85, 0.04);
	}
	.nav-bar {
		max-width: 1180px;
		margin: 0 auto;
		padding: 0.65rem clamp(1rem, 3vw, 1.75rem);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.25rem;
	}
	.brand {
		font-weight: 800;
		letter-spacing: -0.02em;
		color: #0b3555;
		text-decoration: none;
		font-size: 1rem;
		white-space: nowrap;
	}
	.brand:hover {
		color: #072a43;
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.2rem 0.65rem;
		align-items: center;
		justify-content: flex-end;
	}
</style>
