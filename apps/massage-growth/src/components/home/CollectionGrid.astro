---
type Item = {
	title: string;
	description: string;
	href: string;
	image: string;
	imageAlt: string;
};

type Props = {
	items: Item[];
};

const { items } = Astro.props;
---

<div class="collection-grid">
	{
		items.map((item) => (
			<a class="collection-card" href={item.href}>
				<div class="thumb">
					<div class="thumb-blobs" aria-hidden="true" />
					<img src={item.image} alt={item.imageAlt} loading="lazy" width="640" height="360" />
					<div class="thumb-shade" aria-hidden="true" />
				</div>
				<div class="meta">
					<h3>{item.title}</h3>
					<p>{item.description}</p>
					<span class="more">查看专题</span>
				</div>
			</a>
		))
	}
</div>

<style>
	.collection-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.15rem;
	}
	.collection-card {
		display: flex;
		flex-direction: column;
		min-width: 0;
		background: #fff;
		border: 1px solid #cfe1ef;
		border-radius: 22px;
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		box-shadow: 0 4px 14px rgba(11, 58, 83, 0.06);
		transition:
			border-color 0.2s ease,
			box-shadow 0.22s ease,
			transform 0.22s ease;
	}
	.collection-card:hover {
		border-color: #8abae0;
		box-shadow: 0 18px 48px rgba(11, 58, 83, 0.12);
		transform: translateY(-5px);
	}
	.thumb {
		position: relative;
		aspect-ratio: 5 / 3;
		min-height: 148px;
		background: linear-gradient(135deg, #0b3a53 0%, #1a6a94 40%, #2f80ed 100%);
		overflow: hidden;
	}
	.thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		position: relative;
		z-index: 1;
		opacity: 0.9;
		transition: opacity 0.25s ease, transform 0.35s ease;
	}
	.collection-card:hover .thumb img {
		opacity: 1;
		transform: scale(1.04);
	}
	.thumb-blobs {
		position: absolute;
		inset: 0;
		z-index: 0;
		background:
			radial-gradient(circle at 18% 28%, rgba(255, 255, 255, 0.22) 0%, transparent 42%),
			radial-gradient(circle at 82% 18%, rgba(47, 128, 237, 0.45) 0%, transparent 38%),
			radial-gradient(circle at 70% 88%, rgba(255, 255, 255, 0.12) 0%, transparent 45%);
		pointer-events: none;
	}
	.thumb-shade {
		position: absolute;
		inset: 0;
		z-index: 2;
		background: linear-gradient(
			180deg,
			rgba(11, 58, 83, 0.05) 0%,
			transparent 38%,
			rgba(7, 35, 50, 0.38) 100%
		);
		pointer-events: none;
	}
	.meta {
		padding: 1.05rem 1.15rem 1.2rem;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		flex: 1;
		background: linear-gradient(180deg, #fbfdff 0%, #ffffff 100%);
	}
	h3 {
		margin: 0;
		font-size: 1.02rem;
		color: #0b3a53;
		font-weight: 700;
		line-height: 1.32;
		letter-spacing: -0.02em;
	}
	p {
		margin: 0;
		font-size: 0.84rem;
		line-height: 1.55;
		color: #4a6d83;
		flex: 1;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.more {
		font-size: 0.8rem;
		font-weight: 700;
		color: #2f80ed;
		margin-top: 0.2rem;
	}
	@media (max-width: 1100px) {
		.collection-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 560px) {
		.collection-grid {
			grid-template-columns: 1fr;
		}
		.thumb {
			min-height: 160px;
		}
	}
</style>
