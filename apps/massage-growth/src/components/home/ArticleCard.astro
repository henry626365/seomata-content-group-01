---
type Props = {
	href: string;
	title: string;
	description: string;
	image: string;
	imageAlt: string;
	category: string;
	variant?: 'featured' | 'default';
};

const { href, title, description, image, imageAlt, category, variant = 'default' } = Astro.props;
---

<a class:list={['article-card', variant]} href={href}>
	<div class="media">
		<img src={image} alt={imageAlt} loading="lazy" width="800" height="450" />
		<span class="tag">{category}</span>
	</div>
	<div class="body">
		<h3>{title}</h3>
		<p>{description}</p>
	</div>
</a>

<style>
	.article-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		background: #fff;
		border: 1px solid #cfe1ef;
		border-radius: 20px;
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		box-shadow: 0 2px 8px rgba(11, 58, 83, 0.05);
		transition:
			border-color 0.2s ease,
			box-shadow 0.22s ease,
			transform 0.22s ease;
	}
	.article-card:hover {
		border-color: #9ec4e8;
		box-shadow: 0 16px 40px rgba(11, 58, 83, 0.1);
		transform: translateY(-4px);
	}
	.media {
		position: relative;
		aspect-ratio: 16 / 9;
		background: linear-gradient(160deg, #eef5fb 0%, #e3f0fa 100%);
		overflow: hidden;
	}
	.media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.tag {
		position: absolute;
		top: 0.75rem;
		left: 0.75rem;
		background: rgba(255, 255, 255, 0.94);
		color: #0b3a53;
		font-size: 0.72rem;
		font-weight: 700;
		padding: 0.35rem 0.75rem;
		border-radius: 999px;
		border: 1px solid rgba(11, 58, 83, 0.08);
		box-shadow: 0 2px 8px rgba(11, 58, 83, 0.06);
	}
	.body {
		padding: 1rem 1.1rem 1.15rem;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		flex: 1;
	}
	h3 {
		margin: 0;
		font-size: 1.02rem;
		line-height: 1.32;
		color: #0b3a53;
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	p {
		margin: 0;
		font-size: 0.87rem;
		line-height: 1.55;
		color: #4a6b82;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.featured .media {
		aspect-ratio: 4 / 3;
	}
	.featured h3 {
		font-size: 1.22rem;
		line-height: 1.28;
	}
	.featured p {
		font-size: 0.93rem;
		-webkit-line-clamp: 3;
	}
	.featured .body {
		padding: 1.15rem 1.2rem 1.25rem;
	}
</style>
