---
import { sites } from '@seomata/site-config';
import HeaderLink from './HeaderLink.astro';

const site = sites.massageGrowth;
---

<header>
	<nav>
		<h2><a href="/">{site.name}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/google-maps">Google Maps</HeaderLink>
			<HeaderLink href="/reviews">Reviews</HeaderLink>
			<HeaderLink href="/website-conversion">Website Conversion</HeaderLink>
			<HeaderLink href="/massage-seo">Massage SEO</HeaderLink>
			<HeaderLink href="/templates">Templates</HeaderLink>
			<HeaderLink href="/case-breakdowns">Case Breakdowns</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		justify-content: space-between;
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
	}
	nav a {
		padding: 0.85em 0.45em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
		font-size: 0.92rem;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	@media (max-width: 720px) {
		nav {
			flex-direction: column;
		}
		.internal-links {
			justify-content: flex-start;
		}
	}
</style>
