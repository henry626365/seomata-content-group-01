---
import { sites } from '@seomata/site-config';
import HeaderLink from './HeaderLink.astro';

const site = {
	...sites.massageGrowth,
	name: '按摩店增长指南',
	niche: '按摩店本地营销',
	description:
		'面向按摩店、按摩师和养生馆的 Google 地图、本地 SEO、客户评价和预约转化资源。'
};
---

<header>
	<nav>
		<h2><a href="/">{site.name}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/google-maps/">Google 地图</HeaderLink>
			<HeaderLink href="/reviews/">客户评价</HeaderLink>
			<HeaderLink href="/website-conversion/">网站转化</HeaderLink>
			<HeaderLink href="/massage-seo/">按摩 SEO</HeaderLink>
			<HeaderLink href="/templates/">模板</HeaderLink>
			<HeaderLink href="/about/">关于</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1.3rem;
		font-weight: 800;
		line-height: 1.1;
	}

	h2 a,
	h2 a.active {
		color: rgb(var(--accent));
		padding: 0.2rem 0.7rem;
		border-radius: 999px;
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
		padding: 0.35rem 0;
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
	}
	nav a {
		padding: 0.85em 0.45em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
		font-size: 0.92rem;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	@media (max-width: 720px) {
		h2 {
			font-size: 1.15rem;
		}
		nav {
			flex-direction: column;
			align-items: center;
		}
		.internal-links {
			justify-content: center;
		}
	}
</style>
