---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { sites } from '@seomata/site-config';

const site = {
	...sites.massageGrowth,
	name: '按摩店增长指南',
	niche: '按摩店本地营销',
	description:
		'面向按摩店、按摩师和养生馆的 Google 地图、本地 SEO、客户评价和预约转化资源。'
};

const resourceCategories = [
	{
		title: 'Google 地图曝光',
		description:
			'学习如何优化 Google Business Profile，让按摩店更容易出现在本地搜索和地图结果中。'
	},
	{
		title: '客户评价与口碑',
		description:
			'建立评价获取、回复和管理流程，让新客户在预约前更信任你的按摩服务。'
	},
	{
		title: '网站与预约转化',
		description:
			'优化服务页面、价格信息、预约按钮和移动端体验，把访问者转化为真实预约。'
	},
	{
		title: '按摩 SEO 指南',
		description:
			'围绕按摩服务、城市页面和本地关键词建立更清晰的网站内容结构。'
	}
];

const systemSteps = [
	'优化 Google Business Profile',
	'建立清晰的本地服务页面',
	'建立评价请求与回复流程',
	'提升网站预约转化率'
];

const templateCards = [
	{
		title: '评价请求短信模板',
		description:
			'用于到店服务后跟进的短信模板，覆盖邀请评价、提醒补评和基础话术规范。'
	},
	{
		title: '按摩服务页面模板',
		description:
			'用于梳理服务说明、适合人群、时长价格、评价展示与预约入口的页面结构模板。'
	},
	{
		title: 'Google 地图曝光拆解',
		description:
			'用拆解视角检查地图曝光到预约之间的关键环节，定位可执行的优化点。'
	}
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title="按摩店增长指南｜Google 地图、本地 SEO 与预约增长资源"
			description="学习如何通过 Google 地图、本地 SEO、客户评价、服务页面和预约转化优化，帮助按摩店获得更多本地客户。"
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">按摩店增长指南</p>
				<h1>帮助按摩店通过 Google 地图和本地搜索获得更多预约</h1>
				<p>
					为按摩店、按摩师和养生馆提供实用的 Google 地图优化、本地 SEO、客户评价管理和预约转化资源。
				</p>
				<div class="hero-actions">
					<a class="cta primary" href="/blog/massage-seo-checklist/">查看按摩 SEO 检查清单</a>
					<a class="cta secondary" href="/blog/google-business-profile-for-massage-therapists/"
						>学习 Google 地图优化</a
					>
				</div>
			</section>

			<section>
				<h2>专注按摩行业，而不是泛泛的营销建议</h2>
				<p>
					大多数本地 SEO 建议都是写给所有行业的，但按摩店的客户搜索方式、服务项目、评价信任、预约流程和本地竞争环境都有自己的特点。本网站专注解决这些具体问题。
				</p>
			</section>

			<section>
				<h2>核心栏目</h2>
				<div class="card-grid two-col">
					{
						resourceCategories.map((category) => (
							<article class="card">
								<h3>{category.title}</h3>
								<p>{category.description}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="featured-resource">
				<h2>免费按摩 SEO 检查清单</h2>
				<p>
					一份实用清单，帮助你检查 Google Business Profile、服务页面、客户评价、预约按钮和本地 SEO 基础。
				</p>
				<img
					src="/images/massage-seo-checklist-preview.svg"
					alt="按摩店 SEO 检查清单预览图，包含资料页、服务页面、评价、预约按钮和数据追踪项目"
					loading="lazy"
				/>
				<a class="cta primary" href="/blog/massage-seo-checklist/">查看检查清单</a>
			</section>

			<section>
				<h2>按摩店本地曝光增长系统</h2>
				<img
					src="/images/massage-local-search-system.svg"
					alt="按摩店本地搜索转化流程图：搜索、Google 地图、访问网站到完成预约"
					loading="lazy"
				/>
				<ol class="steps">
					{
						systemSteps.map((step) => (
							<li>
								<span class="step-title">{step}</span>
							</li>
						))
					}
				</ol>
			</section>

			<section>
				<h2>模板与拆解</h2>
				<img
					src="/images/massage-review-request-flow.svg"
					alt="按摩店评价流程图：服务完成、短信邀评、Google 评价与店主回复"
					loading="lazy"
				/>
				<div class="card-grid three-col">
					{
						templateCards.map((template) => (
							<article class="card">
								<h3>{template.title}</h3>
								<p>{template.description}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="latest-guides">
				<h2>最新指南</h2>
				<p>查看围绕本地曝光、客户评价与预约转化的最新实操内容。</p>
				<a href="/blog">查看全部指南</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	:global(:root) {
		--massage-primary: #0b3a53;
		--massage-accent: #2f80ed;
		--massage-soft: #eef5fb;
		--massage-border: #d1deea;
	}

	main {
		display: grid;
		gap: 2.25rem;
	}

	section {
		background: #fff;
		border: 1px solid var(--massage-border);
		border-radius: 14px;
		padding: 1.6rem;
	}

	.hero {
		background: #f4f9fc;
		border-color: #c8ddeb;
	}

	.eyebrow {
		font-size: 0.9rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--massage-primary);
		margin-bottom: 0.6rem;
	}

	h1 {
		font-size: clamp(2rem, 4vw, 3rem);
		color: var(--massage-primary);
		margin-bottom: 0.8rem;
	}

	h2 {
		font-size: clamp(1.35rem, 3vw, 2rem);
		color: var(--massage-primary);
		margin-bottom: 1rem;
	}

	h3 {
		font-size: 1.08rem;
		margin: 0;
		color: #143f5a;
	}

	.cta {
		display: inline-block;
		padding: 0.65rem 1.1rem;
		border-radius: 8px;
		font-weight: 600;
		text-decoration: none;
		border: 1px solid transparent;
	}

	.hero-actions {
		margin-top: 1rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.primary {
		background: var(--massage-primary);
		color: #fff;
	}

	.primary:hover {
		background: #07293a;
	}

	.secondary {
		background: #fff;
		color: var(--massage-primary);
		border-color: #b8cde0;
	}

	.secondary:hover {
		background: #f1f7fc;
	}

	.card-grid {
		display: grid;
		gap: 1rem;
	}

	.two-col {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.three-col {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.card {
		background: var(--massage-soft);
		border: 1px solid #cfe1f0;
		border-radius: 10px;
		padding: 1rem;
	}

	.card p {
		margin: 0.7rem 0 0;
		font-size: 0.98rem;
		line-height: 1.55;
		color: #20445e;
	}

	section img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 10px;
		border: 1px solid #c6d9e8;
		margin: 0.4rem 0 1rem;
		background: #fff;
	}

	.featured-resource {
		background: #f7fbff;
	}

	.steps {
		margin: 0;
		padding-left: 1.15rem;
		display: grid;
		gap: 0.75rem;
	}

	.step-title {
		color: #1c3f56;
		font-weight: 600;
	}

	.latest-guides a {
		color: var(--massage-accent);
		font-weight: 600;
		text-decoration: none;
	}

	.latest-guides p {
		margin-bottom: 0.8rem;
	}

	@media (max-width: 840px) {
		.two-col,
		.three-col {
			grid-template-columns: 1fr;
		}
	}
</style>
