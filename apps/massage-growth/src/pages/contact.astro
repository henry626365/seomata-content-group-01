---
import BaseHead from '../components/BaseHead.astro';
import SiteFooter from '../components/home/SiteFooter.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title="联系｜按摩店增长指南"
			description="联系按摩店增长指南，提交建议、纠错反馈或合作咨询。"
		/>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<h1>联系我们</h1>
				<p>
					欢迎通过邮件联系本站，提交内容建议、错误纠正或合作沟通需求。
				</p>
				<p>
					联系邮箱（占位，可后续替换）：
					<a href="mailto:hello@example.com">hello@example.com</a>
				</p>
			</section>
		</main>
		<SiteFooter />
	</body>
</html>

<style>
	section {
		background: #fff;
		border: 1px solid #d2dfeb;
		border-radius: 14px;
		padding: 1.6rem;
	}
	h1 {
		color: #0b3a53;
	}
	a {
		color: #2f80ed;
		text-decoration: none;
		font-weight: 600;
	}
	a:hover {
		text-decoration: underline;
	}
</style>
