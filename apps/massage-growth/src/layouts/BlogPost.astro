---
import type { MarkdownHeading } from '@astrojs/markdown-remark';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import SiteFooter from '../components/home/SiteFooter.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	tocEntries?: MarkdownHeading[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	author = '按摩店增长指南编辑团队',
	tocEntries = []
} = Astro.props;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: min(960px, calc(100% - 2em));
				margin: 0 auto;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				width: 100%;
				height: auto;
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 100%;
				max-width: none;
				margin: 0 auto;
				padding: 1em 0;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1.25rem;
				padding: 1em 0;
				line-height: 1.2;
			}
			.title h1 {
				margin: 0 0 0.65rem 0;
			}
			.meta {
				margin: 0 0 0.75rem;
				padding: 0;
				list-style: none;
				color: rgb(var(--gray));
				display: grid;
				gap: 0.3rem;
				font-size: 0.95rem;
			}
			.meta strong {
				color: rgb(var(--gray-dark));
				font-weight: 700;
			}
			.toc {
				border: 1px solid #d2dfeb;
				border-radius: 12px;
				background: #f7fbff;
				padding: 1rem 1rem 0.9rem;
				margin: 0 0 1.2rem;
			}
			.toc h2 {
				margin: 0 0 0.45rem;
				font-size: 1rem;
				color: #0b3a53;
			}
			.toc p {
				margin: 0;
				color: #47677f;
				font-size: 0.92rem;
			}
			.toc-list {
				margin: 0;
				padding: 0;
				list-style: none;
				display: grid;
				gap: 0.35rem;
			}
			.toc-list a {
				display: block;
				color: #2f80ed;
				text-decoration: none;
				font-size: 0.9rem;
				line-height: 1.45;
				border-radius: 6px;
				padding: 0.2rem 0.35rem;
				margin: 0 -0.35rem;
			}
			.toc-list a:hover {
				background: rgba(47, 128, 237, 0.08);
				text-decoration: underline;
			}
			.toc-item.depth-3 {
				padding-left: 0.85rem;
				border-left: 2px solid rgba(11, 58, 83, 0.12);
				margin-left: 0.15rem;
			}
			.prose :global(h2[id]),
			.prose :global(h3[id]) {
				scroll-margin-top: 5.5rem;
			}
			.related-reading {
				margin-top: 1.4rem;
				padding-top: 1rem;
				border-top: 1px solid #d2dfeb;
			}
			.related-reading h2 {
				margin: 0 0 0.6rem;
				font-size: 1.05rem;
				color: #0b3a53;
			}
			.related-reading ul {
				margin: 0;
				padding-left: 1.15rem;
			}
			.related-reading a {
				color: #2f80ed;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article id="article-top">
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt={`${title} 文章主图`} />}
				</div>
				<div class="prose">
					<div class="title">
						<ul class="meta">
							<li><strong>作者：</strong>{author}</li>
							<li>
								<strong>Published：</strong>
								<FormattedDate date={pubDate} />
							</li>
							{
								updatedDate && (
									<li>
										<strong>Updated：</strong>
										<FormattedDate date={updatedDate} />
									</li>
								)
							}
						</ul>
						<h1>{title}</h1>
						<hr />
					</div>
					{
						tocEntries.length > 0 && (
							<nav class="toc" aria-labelledby="toc-title">
								<h2 id="toc-title">文章目录</h2>
								<ul class="toc-list">
									{tocEntries.map((h) => (
										<li class:list={['toc-item', h.depth === 3 && 'depth-3']}>
											<a href={`#${h.slug}`}>{h.text}</a>
										</li>
									))}
								</ul>
							</nav>
						)
					}
					<slot />
					<section class="related-reading" id="extended-reading" aria-labelledby="related-reading-title">
						<h2 id="related-reading-title">延伸阅读</h2>
						<ul>
							<li><a href="/blog/">浏览全部按摩增长指南</a></li>
							<li><a href="/google-maps/">Google 地图专题</a></li>
							<li><a href="/reviews/">客户评价专题</a></li>
						</ul>
					</section>
				</div>
			</article>
		</main>
		<SiteFooter />
	</body>
</html>
