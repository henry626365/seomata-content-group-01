---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav aria-label="主导航">
		<h2><a class="brand" href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/earning-paths/">赚钱路径</HeaderLink>
			<HeaderLink href="/side-hustles/">副业项目</HeaderLink>
			<HeaderLink href="/online-income/">线上收入</HeaderLink>
			<HeaderLink href="/local-services/">本地服务</HeaderLink>
			<HeaderLink href="/jobs/">找工作</HeaderLink>
			<HeaderLink href="/guides/">实用指南</HeaderLink>
			<HeaderLink href="/about/">关于</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: clamp(0.85rem, 2.2vw, 1.15rem) 0 clamp(0.75rem, 1.8vw, 1rem);
		background: linear-gradient(180deg, #eef2ff 0%, #f9fafb 55%, #ffffff 100%);
		border-bottom: 1px solid #e5e7eb;
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.85) inset,
			0 4px 18px rgba(31, 41, 55, 0.06);
	}

	h2 {
		margin: 0;
		font-size: clamp(1.55rem, 4vw, 2rem);
		font-weight: 800;
		line-height: 1.08;
		letter-spacing: -0.02em;
		flex-shrink: 0;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		color: var(--accent-dark);
		text-decoration: none;
		padding: 0 0 0.1rem;
		white-space: nowrap;
	}

	.brand:hover {
		color: var(--accent);
	}

	nav {
		display: flex;
		align-items: flex-end;
		gap: 1rem;
		justify-content: space-between;
		flex-wrap: wrap;
		width: min(1180px, calc(100% - clamp(1.5rem, 5vw, 3rem)));
		box-sizing: border-box;
		margin-inline: auto;
		padding: 0.45rem 0 0;
	}

	.internal-links {
		display: flex;
		align-items: flex-end;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.42rem;
	}

	@media (max-width: 900px) {
		.internal-links {
			justify-content: flex-start;
			width: 100%;
		}

		nav {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
