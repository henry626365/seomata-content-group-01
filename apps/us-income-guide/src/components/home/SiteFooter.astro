</footer>

<style>
	.site-footer {
		margin-top: clamp(2.25rem, 5vw, 3.5rem);
		padding: clamp(1.75rem, 4vw, 2.75rem) clamp(1rem, 4vw, 1.75rem) 1.65rem;
		background: linear-gradient(180deg, #111827 0%, #1f2937 100%);
		color: #e5e7eb;
		border-top: 1px solid #374151;
	}
	.footer-inner {
		max-width: 1180px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
		gap: clamp(1.5rem, 3vw, 2.5rem);
		align-items: start;
	}
	.brand .name {
		display: block;
		font-size: 1.08rem;
		margin-bottom: 0.5rem;
		color: #fff;
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	.brand p {
		margin: 0;
		max-width: 32rem;
		font-size: 0.88rem;
		line-height: 1.6;
		color: #9ca3af;
	}
	.cols {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(1rem, 2.5vw, 1.5rem);
	}
	.cols h3 {
		margin: 0 0 0.65rem;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #93c5fd;
	}
	.cols ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.45rem;
	}
	.cols a {
		color: #f3f4f6;
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
		border-bottom: 1px solid transparent;
		transition:
			color 0.15s ease,
			border-color 0.15s ease;
	}
	.cols a:hover {
		color: #fff;
		border-bottom-color: rgba(255, 255, 255, 0.35);
	}
	.copy {
		margin: 1.85rem auto 0;
		max-width: 1180px;
		padding-top: 1.2rem;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		font-size: 0.78rem;
		color: #9ca3af;
		text-align: center;
	}
	@media (max-width: 720px) {
		.footer-inner {
			grid-template-columns: 1fr;
		}
	}
</style>
