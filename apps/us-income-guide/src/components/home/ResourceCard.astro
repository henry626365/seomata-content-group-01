---
type Props = {
	href: string;
	title: string;
	description: string;
	image: string;
	imageAlt: string;
	category: string;
};
const { href, title, description, image, imageAlt, category } = Astro.props;
---

<a class="resource-card" href={href}>
	<div class="media">
		<img src={image} alt={imageAlt} loading="lazy" width="640" height="360" />
		<span class="tag">{category}</span>
	</div>
	<div class="body">
		<h3>{title}</h3>
		<p>{description}</p>
	</div>
</a>

<style>
	.resource-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		background: #fff;
		border: 1px solid var(--card-border);
		border-radius: 18px;
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		box-shadow: 0 2px 10px rgba(31, 41, 55, 0.05);
		transition:
			border-color 0.2s ease,
			box-shadow 0.22s ease,
			transform 0.2s ease;
	}
	.resource-card:hover {
		border-color: #c7d2fe;
		box-shadow: 0 14px 36px rgba(37, 99, 235, 0.1);
		transform: translateY(-3px);
	}
	.media {
		position: relative;
		aspect-ratio: 16 / 9;
		background: linear-gradient(155deg, #eef2ff 0%, #e0e7ff 100%);
		overflow: hidden;
	}
	.media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 40%;
	}
	.tag {
		position: absolute;
		top: 0.7rem;
		left: 0.7rem;
		background: rgba(255, 255, 255, 0.95);
		color: var(--ink);
		font-size: 0.7rem;
		font-weight: 700;
		padding: 0.32rem 0.68rem;
		border-radius: 999px;
		border: 1px solid var(--card-border);
		box-shadow: 0 2px 6px rgba(31, 41, 55, 0.05);
	}
	.body {
		padding: 0.95rem 1rem 1.05rem;
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
	h3 {
		margin: 0;
		font-size: 1rem;
		line-height: 1.3;
		color: var(--ink);
		font-weight: 750;
		letter-spacing: -0.02em;
	}
	p {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.55;
		color: var(--ink-muted);
		flex: 1;
	}
</style>
