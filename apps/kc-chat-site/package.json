{
  "name": "@seomata/kc-chat-site",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro build && wrangler dev --port 4322",
    "dev:astro": "astro dev --port 4322",
    "build": "astro build",
    "preview": "astro build && wrangler dev --port 4322",
    "astro": "astro",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote --env production",
    "deploy": "astro build && wrangler deploy --env production",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^6.2.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260520.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
