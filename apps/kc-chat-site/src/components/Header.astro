---
import { NAV_LINKS, GITHUB_URL } from '../consts';

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href + '/') || pathname === href + '/';

const githubIcon =
  '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>';
---

<header class="site-header">
  <div class="header-inner container">
    <a class="logo" href="/" aria-label="KC Chat home">
      <svg width="30" height="30" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect width="32" height="32" rx="8" fill="#0A0D13"/>
        <path d="M9 11l4.2 5-4.2 5" stroke="#4ADE80" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M16.5 21H23" stroke="#4ADE80" stroke-width="2.4" stroke-linecap="round"/>
      </svg>
      <span class="logo-text">KC&nbsp;Chat</span>
    </a>

    <nav class="nav-links" aria-label="Main navigation">
      {NAV_LINKS.map(({ label, href }) => (
        <a
          class:list={['nav-link', { active: isActive(href) }]}
          href={href}
          aria-current={isActive(href) ? 'page' : undefined}
        >
          {label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="nav-link account-link" id="account-link" href="/login">Sign in</a>
      <a class="btn-ghost" href={GITHUB_URL} target="_blank" rel="noopener" aria-label="KC Chat on GitHub">
        <Fragment set:html={githubIcon} />
      </a>
      <a class="btn-primary" href="/docs">Get Started</a>
    </div>

    <button
      class="mobile-toggle"
      id="mobile-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="ic-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
      <svg class="ic-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu">
    <nav class="mobile-nav" aria-label="Mobile navigation">
      {NAV_LINKS.map(({ label, href }) => (
        <a
          class:list={['mobile-link', { active: isActive(href) }]}
          href={href}
          aria-current={isActive(href) ? 'page' : undefined}
        >
          {label}
        </a>
      ))}
    </nav>
    <div class="mobile-cta">
      <a class="btn-ghost-link" id="m-account-link" href="/login">Sign in</a>
      <a class="btn-primary block" href="/docs">Get Started</a>
      <a class="mobile-gh" href={GITHUB_URL} target="_blank" rel="noopener">
        <Fragment set:html={githubIcon} />
        <span>View on GitHub</span>
      </a>
    </div>
  </div>
</header>

<div class="menu-backdrop" id="menu-backdrop" hidden></div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-height);
    background: rgba(250, 250, 247, 0.82);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-subtle);
  }
  .header-inner {
    display: flex;
    align-items: center;
    height: 100%;
    gap: 2rem;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--text-primary);
    flex-shrink: 0;
  }
  .logo-text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex: 1;
  }
  .nav-link {
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s, background 0.2s;
  }
  .nav-link:hover {
    color: var(--text-primary);
    background: var(--color-accent-subtle);
  }
  .nav-link.active {
    color: var(--color-accent);
    background: var(--color-accent-subtle);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    transition: color 0.2s, background 0.2s;
  }
  .btn-ghost:hover {
    color: var(--text-primary);
    background: var(--color-accent-subtle);
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1.1rem;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: #fff;
    font-weight: 600;
    font-size: 0.88rem;
    text-decoration: none;
    transition: background 0.2s, box-shadow 0.2s, transform 0.15s;
    box-shadow: 0 2px 8px rgba(21, 128, 61, 0.25);
  }
  .btn-primary:hover {
    background: var(--color-accent-hover);
    box-shadow: 0 4px 16px rgba(21, 128, 61, 0.35);
    color: #fff;
    transform: translateY(-1px);
  }
  .btn-primary:active {
    transform: scale(0.98);
  }
  .btn-primary.block {
    width: 100%;
    padding-block: 0.7rem;
    font-size: 0.95rem;
  }

  .mobile-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    padding: 0.25rem;
  }
  .mobile-toggle .ic-close { display: none; }
  .mobile-toggle[aria-expanded='true'] .ic-open { display: none; }
  .mobile-toggle[aria-expanded='true'] .ic-close { display: block; }

  /* ---- mobile menu panel ---- */
  .mobile-menu {
    position: fixed;
    top: var(--header-height);
    left: 0;
    right: 0;
    background: var(--bg-card);
    border-bottom: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-elevated);
    padding: 1rem clamp(1rem, 4vw, 2rem) 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transform: translateY(-12px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: transform 0.22s ease, opacity 0.22s ease, visibility 0.22s;
    z-index: 99;
    max-height: calc(100dvh - var(--header-height));
    overflow-y: auto;
  }
  .mobile-menu.open {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .mobile-nav {
    display: flex;
    flex-direction: column;
  }
  .mobile-link {
    padding: 0.85rem 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    border-bottom: 1px solid var(--border-subtle);
  }
  .mobile-link.active { color: var(--color-accent); }
  .mobile-cta {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .mobile-gh {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .btn-ghost-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.1rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
  }
  .menu-backdrop {
    position: fixed;
    inset: var(--header-height) 0 0;
    background: rgba(15, 23, 42, 0.35);
    z-index: 98;
    opacity: 0;
    transition: opacity 0.22s ease;
  }
  .menu-backdrop.show { opacity: 1; }

  @media (max-width: 768px) {
    .nav-links,
    .header-actions {
      display: none;
    }
    .mobile-toggle {
      display: flex;
      margin-left: auto;
    }
  }
  @media (min-width: 769px) {
    .mobile-menu,
    .menu-backdrop { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .menu-backdrop { transition: none; }
  }
</style>

<script>
  const toggle = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');
  const backdrop = document.getElementById('menu-backdrop');

  if (toggle && menu && backdrop) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.classList.toggle('open', open);
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) {
        backdrop.hidden = false;
        requestAnimationFrame(() => backdrop.classList.add('show'));
      } else {
        backdrop.classList.remove('show');
        setTimeout(() => { backdrop.hidden = true; }, 220);
      }
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    backdrop.addEventListener('click', () => setOpen(false));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') setOpen(false);
    });
    window.addEventListener('resize', () => {
      if (window.innerWidth > 768 && toggle.getAttribute('aria-expanded') === 'true') setOpen(false);
    });
  }
</script>

<script is:inline>
  // Reflect Google login state in the header: show the user's name, and send
  // admins to the admin backend instead of the customer account page.
  (function () {
    fetch('/api/auth/me', { credentials: 'same-origin' })
      .then((r) => r.json())
      .then((d) => {
        if (!d || !d.user) return;
        const u = d.user;
        const name = (u.name && u.name.trim()) || (u.email ? u.email.split('@')[0] : 'Account');
        const isAdmin = u.role === 'admin';
        const href = isAdmin ? '/admin' : '/account';
        const label = isAdmin ? (name + ' · Admin') : name;
        for (const id of ['account-link', 'm-account-link']) {
          const el = document.getElementById(id);
          if (el) { el.textContent = label; el.setAttribute('href', href); }
        }
      })
      .catch(() => {});
  })();
</script>
