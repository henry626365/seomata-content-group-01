---
import SectionHeader from '../shared/SectionHeader.astro';

const testimonials = [
  {
    quote: "KC Chat turned my Cursor setup from a single-threaded chatbot into a dev team. The architect agent designs while the frontend agent implements — it's wild.",
    name: 'Alex Chen',
    role: 'Senior Engineer at Vercel',
    avatar: 'A',
    color: 'var(--color-accent)',
  },
  {
    quote: "Autopilot mode is like having a tireless code reviewer. It found issues I would have missed and fixed them before I even looked. Game changer for solo devs.",
    name: 'Sarah Mitchell',
    role: 'Indie Developer',
    avatar: 'S',
    color: 'var(--color-gold)',
  },
  {
    quote: "The KC Flow stepper gives me visibility I never had before. I can see exactly what each agent is doing, where it's stuck, and what's done. No more black box AI.",
    name: 'David Park',
    role: 'Tech Lead at Stripe',
    avatar: 'D',
    color: 'var(--color-primary)',
  },
];
---

<section class="testimonials-section section">
  <div class="container">
    <SectionHeader
      eyebrow="What Developers Say"
      title="Trusted by teams that ship fast"
    />
    <div class="testimonials-grid">
      {testimonials.map((t) => (
        <div class="testimonial-card">
          <blockquote>
            <p>"{t.quote}"</p>
          </blockquote>
          <div class="author">
            <span class="author-avatar" style={`background:${t.color}`}>{t.avatar}</span>
            <div class="author-info">
              <span class="author-name">{t.name}</span>
              <span class="author-role">{t.role}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .testimonial-card {
    position: relative;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.1rem;
    transition: box-shadow 0.25s, transform 0.25s, border-color 0.25s;
  }
  .testimonial-card::before {
    content: '"';
    font-family: var(--font-display);
    font-size: 2.4rem;
    line-height: 0.7;
    color: var(--color-accent);
    opacity: 0.28;
  }
  .testimonial-card:hover {
    box-shadow: var(--shadow-card);
    border-color: var(--border-accent);
    transform: translateY(-3px);
  }
  blockquote p {
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--text-secondary);
    font-style: italic;
  }
  .author {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .author-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-weight: 700;
    font-size: 0.85rem;
    flex-shrink: 0;
  }
  .author-name {
    display: block;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-primary);
  }
  .author-role {
    display: block;
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  @media (max-width: 768px) {
    .testimonials-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
