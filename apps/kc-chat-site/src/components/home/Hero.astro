---

---

<section class="hero bg-dots">
  <div class="hero-inner container">
    <div class="hero-content">
      <span class="hero-badge">
        <span class="live-dot" aria-hidden="true"></span>
        cursor-extension · multi-agent orchestration
      </span>
      <h1>
        Run a whole AI dev team
        <span class="hl-token">inside Cursor</span><span class="caret" aria-hidden="true"></span>
      </h1>
      <p class="hero-lead">
        A Cursor extension that spins up <strong>multiple specialized AI agents</strong> — architect,
        frontend, backend, QA — working in parallel. An autopilot orchestrates them and KC Flow shows
        live progress. Pay once, no subscription.
      </p>

      <div class="hero-ledger" role="img" aria-label="A solo Cursor chat works one task at a time, while KC Chat runs four specialized agents in parallel with autopilot">
        <div class="ledger-row removed">
          <span class="ledger-sign">−</span>
          <span class="ledger-label">Solo Cursor chat</span>
          <span class="ledger-val">1 task<small>at a time</small></span>
        </div>
        <div class="ledger-row added">
          <span class="ledger-sign">+</span>
          <span class="ledger-label">KC Chat <span class="ledger-note">(4 agents)</span></span>
          <span class="ledger-val">parallel<small>+ autopilot</small></span>
        </div>
      </div>

      <div class="hero-actions">
        <a class="btn-cta" href="/pricing">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          See pricing
        </a>
        <a class="btn-secondary" href="/tutorial">
          How it works (5 min)
        </a>
      </div>
      <div class="hero-social-proof">
        <span class="social-text">No subscription · one-time payment · 7-day refund if unactivated</span>
      </div>
    </div>

    <div class="hero-visual">
      <!-- "Before" terminal: out of tokens -->
      <div class="terminal terminal-before">
        <div class="term-bar">
          <span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span>
          <span class="term-title">cursor · without KC Chat</span>
        </div>
        <div class="term-body">
          <div class="line"><span class="prompt">$</span> <span class="cmd">write me an OAuth flow</span></div>
          <div class="line line-error">
            <span class="ic">⚠</span>
            <span class="err-text">You have used <strong>100%</strong> of your monthly fast requests. Upgrade or wait 11 days.</span>
          </div>
          <div class="meter">
            <div class="meter-label">Token quota</div>
            <div class="meter-bar"><div class="meter-fill" style="width:100%"></div></div>
            <div class="meter-stat"><span class="bad">0 left</span> · next reset in <strong>11d 4h</strong></div>
          </div>
          <div class="cost-row">
            <span class="cost-tag">Anthropic overage this month</span>
            <span class="cost-tag-val red">−$147.30</span>
          </div>
        </div>
      </div>

      <!-- "After" terminal: KC Chat unlocked -->
      <div class="terminal terminal-after">
        <div class="term-bar">
          <span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span>
          <span class="term-title">cursor · with KC Chat <span class="active-pill">Activated</span></span>
        </div>
        <div class="term-body">
          <div class="line"><span class="prompt">$</span> <span class="cmd">write me an OAuth flow</span></div>
          <div class="line line-ok">
            <span class="ic">✓</span>
            <span class="ok-text">Working — <strong>unlimited</strong> conversation mode active.</span>
          </div>
          <div class="meter">
            <div class="meter-label">Token quota <span class="bypassed">· bypassed</span></div>
            <div class="meter-bar"><div class="meter-fill-good" style="width:100%"></div></div>
            <div class="meter-stat"><span class="g">∞ remaining</span> · expires <strong>2126-05-05</strong></div>
          </div>
          <div class="cost-row">
            <span class="cost-tag">Anthropic overage this month</span>
            <span class="cost-tag-val green">$0.00</span>
          </div>
        </div>
      </div>

      <div class="arrow-conn" aria-hidden="true">
        <span>↓</span>
      </div>
    </div>
  </div>

  <div class="hero-bg-glow"></div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(3rem, 8vw, 5rem) 0 clamp(2.5rem, 6vw, 4rem);
  }
  .hero-bg-glow {
    position: absolute;
    top: -40%;
    right: -10%;
    width: 620px;
    height: 620px;
    background: radial-gradient(circle, rgba(34, 197, 94, 0.10) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    border: 1px solid var(--border-accent);
    padding: 0.34rem 0.85rem 0.34rem 0.7rem;
    border-radius: 100px;
    margin-bottom: 1.4rem;
  }
  .live-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--color-signal);
    box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.55);
    animation: live-pulse 2s ease-out infinite;
    flex-shrink: 0;
  }
  @keyframes live-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.5); }
    70%  { box-shadow: 0 0 0 6px rgba(34, 197, 94, 0); }
    100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
  }
  h1 {
    font-size: clamp(2.1rem, 4.6vw, 3.35rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.035em;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
  }
  /* "out of tokens" rendered as a terminal error token */
  .err-token {
    font-family: var(--font-mono);
    font-size: 0.82em;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-danger);
    background: rgba(220, 38, 38, 0.08);
    border: 1px solid rgba(220, 38, 38, 0.22);
    border-radius: var(--radius-sm);
    padding: 0.05em 0.4em;
    white-space: nowrap;
  }
  /* Positive inline highlight (mirrors .err-token shape, accent color) */
  .hl-token {
    font-family: var(--font-mono);
    font-size: 0.82em;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    border: 1px solid var(--border-accent);
    border-radius: var(--radius-sm);
    padding: 0.05em 0.4em;
    white-space: nowrap;
  }
  .hero-lead {
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 48ch;
    margin-bottom: 1.6rem;
  }

  /* Cost ledger — git-diff styled */
  .hero-ledger {
    font-family: var(--font-mono);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 0.5rem 0.5rem;
    margin-bottom: 1.6rem;
    max-width: max-content;
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }
  .ledger-row {
    display: grid;
    grid-template-columns: 1.1rem 1fr auto;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius-sm);
    font-size: 0.82rem;
  }
  .ledger-row.removed { background: rgba(220, 38, 38, 0.06); }
  .ledger-row.added   { background: rgba(34, 197, 94, 0.08); margin-top: 0.25rem; }
  .ledger-sign { font-weight: 700; text-align: center; }
  .ledger-row.removed .ledger-sign { color: var(--color-danger); }
  .ledger-row.added   .ledger-sign { color: var(--color-accent); }
  .ledger-label { color: var(--text-secondary); }
  .ledger-note { color: var(--text-muted); }
  .ledger-val { font-weight: 700; font-variant-numeric: tabular-nums; }
  .ledger-row.removed .ledger-val { color: var(--color-danger); text-decoration: line-through; text-decoration-thickness: 1px; opacity: 0.85; }
  .ledger-row.added   .ledger-val { color: var(--color-accent); }
  .ledger-val small { font-size: 0.68em; font-weight: 600; opacity: 0.7; margin-left: 0.2em; }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.6rem;
  }
  .btn-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.78rem 1.5rem;
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: #fff;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.2s;
    box-shadow: 0 4px 16px rgba(21, 128, 61, 0.28);
  }
  .btn-cta:hover {
    background: var(--color-accent-hover);
    box-shadow: 0 6px 24px rgba(21, 128, 61, 0.38);
    transform: translateY(-2px);
    color: #fff;
  }
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 0.78rem 1.5rem;
    border-radius: var(--radius-md);
    background: var(--bg-card);
    color: var(--text-primary);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border: 1px solid var(--border-strong);
    transition: all 0.2s;
  }
  .btn-secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    box-shadow: var(--shadow-sm);
  }

  .hero-social-proof {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .stars {
    display: flex;
    gap: 2px;
  }
  .social-text {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  /* Before/After terminals */
  .hero-visual {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: stretch;
  }
  .terminal {
    background: var(--bg-dark);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-elevated);
    border: 1px solid var(--border-dark);
    font-family: var(--font-mono);
    color: #E2E8F0;
  }
  .terminal-before {
    transform: rotate(-1deg);
    opacity: 0.92;
  }
  .terminal-after {
    transform: rotate(1deg);
    box-shadow: var(--shadow-elevated), 0 0 40px rgba(34, 197, 94, 0.22);
    border-color: rgba(34, 197, 94, 0.32);
  }
  .term-bar {
    display: flex; align-items: center; gap: 8px;
    padding: 0.6rem 0.85rem;
    background: rgba(255,255,255,.03);
    border-bottom: 1px solid rgba(255,255,255,.05);
  }
  .dot {
    width: 10px; height: 10px; border-radius: 50%;
  }
  .dot.red { background: #ef4444; }
  .dot.yellow { background: #eab308; }
  .dot.green { background: #22c55e; }
  .term-title {
    font-size: 0.72rem; color: var(--text-on-dark-muted);
    margin-left: 0.4rem; flex: 1;
  }
  .active-pill {
    color: #6EE7B7; background: rgba(16,185,129,.15);
    padding: 0.05rem 0.45rem; border-radius: 999px;
    font-size: 0.62rem; margin-left: 0.3rem; font-weight: 700;
    border: 1px solid rgba(16,185,129,.3);
  }
  .term-body { padding: 0.9rem 1rem 1rem; font-size: 0.78rem; }
  .line { line-height: 1.7; margin: 0.15rem 0; }
  .prompt { color: var(--color-signal-bright); margin-right: 0.4rem; }
  .cmd { color: #E2E8F0; }
  .ic { display: inline-block; width: 1.1em; }
  .line-error { color: #FCA5A5; }
  .line-ok    { color: #86EFAC; }
  .err-text strong, .ok-text strong { font-weight: 700; }

  .meter {
    margin: 0.85rem 0 0.4rem;
    padding: 0.55rem 0.7rem;
    background: rgba(255,255,255,.03);
    border-radius: var(--radius-sm);
  }
  .meter-label {
    font-size: 0.7rem; color: var(--text-on-dark-muted);
    text-transform: uppercase; letter-spacing: 0.05em;
    margin-bottom: 0.35rem;
  }
  .meter-label .bypassed { color: #6EE7B7; text-transform: none; letter-spacing: 0; font-weight: 600; }
  .meter-bar {
    height: 6px; background: rgba(255,255,255,.08); border-radius: 99px; overflow: hidden;
  }
  .meter-fill {
    height: 100%; background: linear-gradient(90deg, #FCA5A5, #EF4444);
    width: 100%; border-radius: inherit;
  }
  .meter-fill-good {
    height: 100%; background: linear-gradient(90deg, #10B981, #34D399);
    border-radius: inherit;
    animation: pulse-good 2.4s ease-in-out infinite;
  }
  @keyframes pulse-good {
    0%,100% { opacity: 1; }
    50% { opacity: 0.7; }
  }
  .meter-stat {
    font-size: 0.7rem; color: var(--text-on-dark-muted); margin-top: 0.3rem;
  }
  .meter-stat .bad { color: #FCA5A5; font-weight: 700; }
  .meter-stat .g   { color: #6EE7B7; font-weight: 700; }

  .cost-row {
    display: flex; justify-content: space-between; align-items: center;
    margin-top: 0.75rem; padding: 0.5rem 0.7rem;
    background: rgba(255,255,255,.03); border-radius: var(--radius-sm);
    font-size: 0.78rem;
  }
  .cost-tag { color: var(--text-on-dark-muted); }
  .cost-tag-val { font-weight: 700; font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  .cost-tag-val.red { color: #FCA5A5; }
  .cost-tag-val.green {
    color: #6EE7B7;
    background: rgba(16,185,129,.15);
    padding: 0.05rem 0.45rem;
    border-radius: 4px;
  }

  .arrow-conn {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 38px; height: 38px;
    background: var(--bg-page);
    border: 2px solid var(--color-accent);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem; color: var(--color-accent); font-weight: 800;
    z-index: 10;
    box-shadow: var(--shadow-card);
  }

  @media (max-width: 960px) {
    .hero-inner { grid-template-columns: 1fr; text-align: center; }
    .hero-lead { margin-inline: auto; }
    .hero-actions { justify-content: center; }
    .hero-social-proof { justify-content: center; }
    .hero-badge { margin-inline: auto; }
    .hero-ledger { margin-inline: auto; }
    .terminal-before, .terminal-after { transform: none; }
    .hero-visual { max-width: 460px; margin-inline: auto; }
  }
</style>
