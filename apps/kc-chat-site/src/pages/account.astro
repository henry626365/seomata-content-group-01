---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout title="My account — KC Chat" description="View your KC Chat orders and card-keys.">
  <section class="section">
    <div class="container account-page">
      <div id="loading" class="muted">Loading…</div>

      <div id="account" hidden>
        <header class="acct-head">
          <div class="acct-id">
            <img id="acct-pic" class="acct-pic" alt="" hidden />
            <div>
              <h1 id="acct-name">My account</h1>
              <p id="acct-email" class="muted"></p>
            </div>
          </div>
          <div class="acct-actions">
            <a id="admin-link" class="btn-ghost" href="/admin" hidden>Admin</a>
            <button id="logout-btn" class="btn-ghost" type="button">Sign out</button>
          </div>
        </header>

        <section class="card balance-card">
          <div class="bal-row">
            <div>
              <h2>Balance</h2>
              <p id="bal-amount" class="bal-amount">—</p>
            </div>
            <button id="recharge-btn" class="btn-primary" type="button">Recharge with BTC</button>
          </div>

          <div id="recharge-box" class="recharge-box" hidden>
            <p class="muted rc-help">
              Send any amount of BTC to your personal address below. Your balance is credited
              automatically after <span id="rc-conf">2</span> confirmation(s), converted at the
              market exchange rate at the time of crediting.
            </p>

            <div id="rc-status" class="rc-status" role="status" aria-live="polite" hidden></div>

            <div class="rc-grid">
              <div id="rc-qr" class="rc-qr" role="img" aria-label="BTC deposit address QR code" hidden></div>
              <div class="rc-info">
                <label class="rc-label">Your BTC deposit address</label>
                <div class="rc-addr-row">
                  <code id="rc-addr" class="mono rc-addr">—</code>
                  <button id="rc-copy" class="btn-tiny" type="button">Copy</button>
                </div>
                <p id="rc-rate" class="muted rc-rate"></p>
                <p id="rc-target" class="rc-target" hidden></p>
              </div>
            </div>
          </div>

          <h3 class="buy-title">Buy a plan with your balance</h3>
          <div id="buy-error" class="inline-error" role="alert" hidden></div>
          <div id="buy-grid" class="buy-grid"></div>
        </section>

        <section class="card">
          <h2>Your orders</h2>
          <div id="orders-empty" class="muted" hidden>
            No orders yet. <a href="/pricing">Browse plans →</a>
          </div>
          <div class="table-wrap">
            <table id="orders-table" class="table" hidden>
              <thead>
                <tr><th>Date</th><th>Plan</th><th>Status</th><th>Card-key</th><th>Amount</th><th></th></tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
        </section>

        <section class="card">
          <h2>BTC deposits</h2>
          <div id="deposits-empty" class="muted" hidden>No deposits yet.</div>
          <div class="table-wrap">
            <table id="deposits-table" class="table" hidden>
              <thead>
                <tr><th>Date</th><th>Amount (BTC)</th><th>Status</th><th>Credited</th><th>Conf.</th></tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
        </section>
      </div>
    </div>
  </section>

  <!-- Purchase confirmation sheet -->
  <div id="confirm-modal" class="modal-overlay" hidden>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="cm-title">
      <h3 id="cm-title" class="modal-title">Confirm purchase</h3>
      <div class="modal-kv">
        <div class="kv"><span>Plan</span><b id="cm-plan">—</b></div>
        <div class="kv"><span>Price</span><b id="cm-price">—</b></div>
        <div class="kv"><span>Current balance</span><b id="cm-balance">—</b></div>
        <div class="kv kv--accent"><span>Balance after</span><b id="cm-after">—</b></div>
      </div>
      <div class="modal-actions">
        <button id="cm-cancel" class="btn-ghost" type="button">Cancel</button>
        <button id="cm-confirm" class="btn-primary" type="button">Confirm purchase →</button>
      </div>
    </div>
  </div>

  <!-- Card-key delivery (success) -->
  <div id="success-modal" class="modal-overlay" hidden>
    <div class="modal modal--success" role="dialog" aria-modal="true" aria-labelledby="sm-title">
      <div class="sm-emoji" aria-hidden="true">🎉</div>
      <h3 id="sm-title" class="modal-title">Purchased! <span id="sm-plan"></span></h3>
      <label class="rc-label">Your card-key</label>
      <div class="sm-code-row">
        <code id="sm-code" class="mono sm-code">—</code>
        <button id="sm-copy" class="btn-tiny" type="button">Copy</button>
      </div>
      <p class="muted sm-sent">Also emailed to <span id="sm-email">your email</span>.</p>
      <div class="modal-actions">
        <a id="sm-activate" class="btn-ghost" href="#">Activate now →</a>
        <button id="sm-done" class="btn-primary" type="button">Done</button>
      </div>
    </div>
  </div>

  <!-- Local QR generator (bundled by Astro/Vite) — no external service. -->
  <script>
    import qrcode from 'qrcode-generator';
    window.__btcQR = (data) => {
      const qr = qrcode(0, 'M');
      qr.addData(data);
      qr.make();
      return qr.createSvgTag({ cellSize: 4, margin: 2, scalable: true });
    };
    window.dispatchEvent(new Event('btcqr-ready'));
  </script>

  <script is:inline>
    const $ = (id) => document.getElementById(id);
    const TIER_LABEL = { day: 'Day Pass', month: 'Monthly', year: 'Yearly', lifetime: 'Lifetime', lite: 'Lite' };

    // Plan prices in cents — kept in sync with functions/lib/cards.ts (TIERS).
    const BUY_TIERS = [
      { id: 'day', label: 'Day Pass', cents: 500 },
      { id: 'lite', label: 'Lite · 30d', cents: 1000 },
      { id: 'month', label: 'Monthly', cents: 9800 },
      { id: 'year', label: 'Yearly', cents: 19800 },
      { id: 'lifetime', label: 'Lifetime', cents: 29800 },
    ];

    let balanceCents = 0;
    let creditCurrency = 'usd';
    let rechargeLoaded = false;
    let rateCentsPerBtc = 0; // 0 = live rate temporarily unavailable
    let minConf = 2;
    let targetTier = null; // a tier the user is recharging toward
    let userEmail = '';

    const money = (cents, cur) =>
      cents == null ? '—' : (cents / 100).toLocaleString(undefined, { style: 'currency', currency: (cur || creditCurrency || 'usd').toUpperCase() });
    const fmtDate = (t) => (t ? new Date(t).toISOString().slice(0, 10) : '—');
    const btcAmt = (sat) => (sat == null ? '—' : (sat / 1e8).toFixed(8).replace(/0+$/, '').replace(/\.$/, ''));
    const btcForCents = (cents) =>
      rateCentsPerBtc > 0 ? (cents / rateCentsPerBtc).toFixed(8).replace(/0+$/, '').replace(/\.$/, '') : null;

    /* ───────────────────────── Buy grid (affordability three states) ─────────────── */

    function renderBuyGrid() {
      const grid = $('buy-grid');
      grid.innerHTML = '';
      for (const t of BUY_TIERS) {
        const affordable = balanceCents >= t.cents;
        const isTarget = targetTier === t.id;

        const item = document.createElement('div');
        item.className = 'buy-item' + (affordable ? ' buy-item--ok' : '') + (isTarget ? ' buy-item--target' : '');

        const name = document.createElement('div');
        name.className = 'buy-name';
        name.textContent = t.label;

        const price = document.createElement('div');
        price.className = 'buy-price';
        price.textContent = money(t.cents);

        item.appendChild(name);
        item.appendChild(price);

        if (affordable) {
          const b = document.createElement('button');
          b.className = 'btn-buy';
          b.type = 'button';
          b.textContent = 'Buy';
          b.onclick = () => buyPlan(t, b);
          item.appendChild(b);
        } else {
          const gap = document.createElement('div');
          gap.className = 'buy-gap';
          gap.textContent = 'Need ' + money(t.cents - balanceCents) + ' more';
          const b = document.createElement('button');
          b.className = 'btn-buy btn-buy--ghost';
          b.type = 'button';
          b.textContent = isTarget ? 'Selected · recharge ↑' : 'Recharge to buy';
          b.onclick = () => {
            targetTier = t.id;
            $('recharge-box').hidden = false;
            renderBuyGrid();
            openRecharge();
            $('recharge-box').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          };
          item.appendChild(gap);
          item.appendChild(b);
        }
        grid.appendChild(item);
      }
    }

    /* ───────────────────────── Recharge (address + QR + live polling) ─────────────── */

    function setupRecharge() {
      $('recharge-btn').onclick = () => {
        const box = $('recharge-box');
        box.hidden = !box.hidden;
        if (!box.hidden) openRecharge();
      };
      $('rc-copy').onclick = () => copyText($('rc-addr').textContent, $('rc-copy'), 'Copy');
    }

    function updateTargetHint() {
      const el = $('rc-target');
      if (!targetTier) { el.hidden = true; return; }
      const t = BUY_TIERS.find((x) => x.id === targetTier);
      if (!t) { el.hidden = true; return; }
      const need = btcForCents(t.cents);
      el.hidden = false;
      el.innerHTML = need
        ? 'Buying <b>' + t.label + '</b> (' + money(t.cents) + ')? Send about <b>' + need + ' BTC</b>.'
        : 'Buying <b>' + t.label + '</b> (' + money(t.cents) + '). Send enough to cover it at the confirmation-time rate.';
    }

    async function openRecharge() {
      ensurePolling();
      if (rechargeLoaded) { updateTargetHint(); return; }
      try {
        const r = await fetch('/api/account/btc/recharge', { method: 'POST', credentials: 'same-origin' });
        const d = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(d.message || d.code || ('HTTP ' + r.status));
        rechargeLoaded = true;
        rateCentsPerBtc = d.rate_cents_per_btc || 0;
        minConf = d.min_confirmations != null ? d.min_confirmations : 2;
        $('rc-addr').textContent = d.address;
        $('rc-conf').textContent = minConf;
        renderQR(d.address);
        $('rc-rate').textContent = rateCentsPerBtc > 0
          ? 'Current rate: 1 BTC ≈ ' + money(rateCentsPerBtc, d.currency)
          : 'Live rate temporarily unavailable — deposits are still credited at the rate when confirmed.';
        updateTargetHint();
      } catch (e) {
        $('rc-addr').textContent = '—';
        $('rc-rate').textContent = 'Could not load a deposit address: ' + e.message;
      }
    }

    function renderQR(address) {
      const box = $('rc-qr');
      const data = 'bitcoin:' + address;
      const draw = () => {
        try { box.innerHTML = window.__btcQR(data); box.hidden = false; }
        catch { box.hidden = true; }
      };
      if (window.__btcQR) draw();
      else window.addEventListener('btcqr-ready', draw, { once: true });
    }

    function setRcStatus(kind, html) {
      const el = $('rc-status');
      if (!html) { el.hidden = true; return; }
      el.className = 'rc-status rc-status--' + kind;
      el.innerHTML = html;
      el.hidden = false;
    }

    /* ───────────────────────── Smart deposit polling ─────────────── */

    let pollTimer = null;
    let pollStartedAt = 0;
    let prevDeposits = new Map(); // id -> { status, confirmations }
    let creditFlashUntil = 0;

    function depositsHavePending(items) {
      return items.some((it) => it.status === 'pending');
    }

    function ensurePolling() {
      if (pollTimer) return;
      pollStartedAt = Date.now();
      scheduleNextPoll(0);
    }

    function stopPolling() {
      if (pollTimer) { clearTimeout(pollTimer); pollTimer = null; }
    }

    function scheduleNextPoll(delay) {
      pollTimer = setTimeout(pollTick, delay);
    }

    async function pollTick() {
      pollTimer = null;
      if (document.hidden) { scheduleNextPoll(8000); return; } // pause work while hidden
      let keepGoing = false;
      try {
        keepGoing = await loadBalance();
      } catch { keepGoing = false; }
      const boxOpen = !$('recharge-box').hidden;
      const flashing = Date.now() < creditFlashUntil;
      if (boxOpen || keepGoing || flashing) {
        const elapsed = Date.now() - pollStartedAt;
        scheduleNextPoll(elapsed < 120000 ? 8000 : 20000);
      }
    }

    /* ───────────────────────── Balance + deposits load (with diff) ─────────────── */

    function countUp(el, fromCents, toCents) {
      if (fromCents === toCents) { el.textContent = money(toCents); return; }
      const start = performance.now();
      const dur = 450;
      function frame(now) {
        const p = Math.min(1, (now - start) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = money(Math.round(fromCents + (toCents - fromCents) * eased));
        if (p < 1) requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);
    }

    async function loadBalance() {
      const d = await (await fetch('/api/account/btc/deposits', { credentials: 'same-origin' })).json();
      const newBal = d.balance_cents || 0;
      creditCurrency = d.currency || 'usd';
      const items = (d && d.items) || [];

      // Diff against previous snapshot to drive the live status bar.
      let newlyCredited = 0;
      let sawNewPending = false;
      for (const it of items) {
        const prev = prevDeposits.get(it.id);
        if (it.status === 'credited' && (!prev || prev.status !== 'credited')) {
          newlyCredited += it.credited_cents || 0;
        }
        if (it.status === 'pending' && !prev) sawNewPending = true;
      }
      const hadSnapshot = prevDeposits.size > 0;
      prevDeposits = new Map(items.map((it) => [it.id, { status: it.status, confirmations: it.confirmations }]));

      // Animate the balance number if it changed.
      if (newBal !== balanceCents) {
        countUp($('bal-amount'), balanceCents, newBal);
        balanceCents = newBal;
      } else {
        $('bal-amount').textContent = money(balanceCents);
      }

      // Status bar messaging.
      if (hadSnapshot && newlyCredited > 0) {
        creditFlashUntil = Date.now() + 6000;
        setRcStatus('ok', '✅ Received <b>+' + money(newlyCredited) + '</b> · balance now <b>' + money(balanceCents) + '</b>');
        loadOrders(); // a credit may unlock affordability; orders unchanged but keep fresh
        setTimeout(() => { if (Date.now() >= creditFlashUntil) setRcStatus('ok', ''); }, 6000);
      } else if (depositsHavePending(items)) {
        const p = items.find((it) => it.status === 'pending');
        const conf = p && p.confirmations != null ? p.confirmations : 0;
        setRcStatus('pending', '⏳ Deposit detected · <b>' + conf + '/' + minConf + '</b> confirmations · usually 10–30 min');
      } else if (Date.now() >= creditFlashUntil && !$('recharge-box').hidden && rechargeLoaded) {
        setRcStatus('wait', '⏳ Waiting for your transfer… this updates automatically.');
      }

      renderBuyGrid();
      renderDeposits(items);
      return depositsHavePending(items);
    }

    function renderDeposits(items) {
      if (!items.length) { $('deposits-empty').hidden = false; $('deposits-table').hidden = true; return; }
      const tbody = $('deposits-table').querySelector('tbody');
      tbody.innerHTML = '';
      const stLabel = { pending: 'Pending', credited: 'Credited', ignored: 'Ignored' };
      for (const it of items) {
        const tr = document.createElement('tr');
        const td = (txt, mono) => { const c = document.createElement('td'); if (mono) c.className = 'mono'; c.textContent = txt; return c; };
        tr.appendChild(td(fmtDate(it.first_seen_at)));
        tr.appendChild(td(btcAmt(it.amount_sat), true));
        const st = document.createElement('td');
        const badge = document.createElement('span');
        badge.className = 'badge badge--' + (it.status === 'credited' ? 'paid' : it.status === 'pending' ? 'pending' : 'refunded');
        badge.textContent = stLabel[it.status] || it.status;
        st.appendChild(badge);
        tr.appendChild(st);
        tr.appendChild(td(it.credited_cents != null ? money(it.credited_cents, it.currency) : '—'));
        tr.appendChild(td(String(it.confirmations != null ? it.confirmations : '—')));
        tbody.appendChild(tr);
      }
      $('deposits-empty').hidden = true;
      $('deposits-table').hidden = false;
    }

    /* ───────────────────────── Buy flow (confirm sheet → success modal) ─────────────── */

    function showBuyError(msg) {
      const el = $('buy-error');
      el.textContent = msg;
      el.hidden = false;
      el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      setTimeout(() => { el.hidden = true; }, 6000);
    }

    function buyPlan(t, btnEl) {
      openConfirm(t, btnEl);
    }

    function openConfirm(t, btnEl) {
      $('cm-plan').textContent = t.label;
      $('cm-price').textContent = money(t.cents);
      $('cm-balance').textContent = money(balanceCents);
      $('cm-after').textContent = money(balanceCents - t.cents);
      const confirmBtn = $('cm-confirm');
      confirmBtn.disabled = false;
      confirmBtn.textContent = 'Confirm purchase →';
      confirmBtn.onclick = () => doBuy(t, confirmBtn, btnEl);
      openModal('confirm-modal', confirmBtn);
    }

    async function doBuy(t, confirmBtn, originBtn) {
      confirmBtn.disabled = true;
      confirmBtn.textContent = 'Processing…';
      if (originBtn) originBtn.disabled = true;
      try {
        const r = await fetch('/api/account/buy', {
          method: 'POST', credentials: 'same-origin',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ tier: t.id }),
        });
        const d = await r.json().catch(() => ({}));

        if (r.status === 402) {
          closeModal('confirm-modal');
          targetTier = t.id;
          $('recharge-box').hidden = false;
          renderBuyGrid();
          openRecharge();
          const need = (d.price_cents || t.cents) - (d.balance_cents != null ? d.balance_cents : balanceCents);
          setRcStatus('wait', 'Need <b>' + money(need) + '</b> more for ' + t.label + '. Recharge below — your balance updates automatically.');
          $('recharge-box').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          return;
        }
        if (r.status === 409) {
          closeModal('confirm-modal');
          if (d.balance_cents != null) { countUp($('bal-amount'), balanceCents, d.balance_cents); balanceCents = d.balance_cents; renderBuyGrid(); }
          showBuyError(t.label + ' is temporarily out of stock — your balance was not charged.');
          return;
        }
        if (!r.ok) throw new Error(d.message || d.code || ('HTTP ' + r.status));

        // Success → update balance immediately, then celebrate.
        if (d.balance_cents != null) { countUp($('bal-amount'), balanceCents, d.balance_cents); balanceCents = d.balance_cents; }
        closeModal('confirm-modal');
        renderBuyGrid();
        loadOrders();
        showSuccess(t, d.card_code);
      } catch (e) {
        closeModal('confirm-modal');
        showBuyError('Purchase failed: ' + e.message);
      } finally {
        if (originBtn) originBtn.disabled = false;
      }
    }

    function showSuccess(t, code) {
      $('sm-plan').textContent = t.label;
      $('sm-code').textContent = code || '—';
      $('sm-email').textContent = userEmail || 'your email';
      const act = $('sm-activate');
      act.href = code ? '/activate?code=' + encodeURIComponent(code) : '/activate';
      $('sm-copy').onclick = () => copyText(code, $('sm-copy'), 'Copy');
      openModal('success-modal', $('sm-done'));
    }

    /* ───────────────────────── Modal helpers (focus trap + Esc + overlay) ─────────────── */

    let activeModal = null;
    let lastFocused = null;

    function openModal(id, focusEl) {
      const overlay = $(id);
      lastFocused = document.activeElement;
      overlay.hidden = false;
      activeModal = overlay;
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => { (focusEl || overlay.querySelector('button, a, input')).focus(); });
    }

    function closeModal(id) {
      const overlay = id ? $(id) : activeModal;
      if (!overlay) return;
      overlay.hidden = true;
      if (activeModal === overlay) activeModal = null;
      if (!activeModal) document.body.style.overflow = '';
      if (lastFocused && lastFocused.focus) lastFocused.focus();
    }

    function wireModals() {
      $('cm-cancel').onclick = () => closeModal('confirm-modal');
      $('sm-done').onclick = () => closeModal('success-modal');
      for (const id of ['confirm-modal', 'success-modal']) {
        $(id).addEventListener('mousedown', (e) => { if (e.target === $(id)) closeModal(id); });
      }
      document.addEventListener('keydown', (e) => {
        if (!activeModal) return;
        if (e.key === 'Escape') { e.preventDefault(); closeModal(); return; }
        if (e.key === 'Tab') {
          const f = activeModal.querySelectorAll('button:not([disabled]), a[href], input, [tabindex]:not([tabindex="-1"])');
          if (!f.length) return;
          const first = f[0], last = f[f.length - 1];
          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        }
      });
    }

    async function copyText(text, btnEl, restore) {
      if (!text || text === '—') return;
      try {
        await navigator.clipboard.writeText(text);
        const orig = restore || btnEl.textContent;
        btnEl.textContent = 'Copied ✓';
        btnEl.classList.add('btn-tiny--ok');
        setTimeout(() => { btnEl.textContent = orig; btnEl.classList.remove('btn-tiny--ok'); }, 1500);
      } catch {}
    }

    /* ───────────────────────── Orders ─────────────── */

    async function loadOrders() {
      try {
        const data = await (await fetch('/api/account/orders', { credentials: 'same-origin' })).json();
        const items = (data && data.items) || [];
        const tbody = $('orders-table').querySelector('tbody');
        tbody.innerHTML = '';
        if (!items.length) {
          $('orders-empty').hidden = false;
          $('orders-empty').innerHTML = 'No orders yet. <a href="/pricing">Browse plans →</a>';
          $('orders-table').hidden = true;
          return;
        }
        const statusLabel = { pending: 'Pending', paid: 'Paid', refunded: 'Refunded', failed: 'Failed' };
        for (const o of items) {
          const tr = document.createElement('tr');
          const td = (txt, mono) => { const c = document.createElement('td'); if (mono) c.className = 'mono'; c.textContent = txt; return c; };
          tr.appendChild(td(fmtDate(o.created_at)));
          tr.appendChild(td(TIER_LABEL[o.tier] || o.tier));
          const st = document.createElement('td');
          const badge = document.createElement('span');
          badge.className = 'badge badge--' + o.status;
          badge.textContent = statusLabel[o.status] || o.status;
          st.appendChild(badge);
          tr.appendChild(st);
          tr.appendChild(td(o.status === 'paid' && o.card_code ? o.card_code : '—', true));
          tr.appendChild(td(money(o.amount_cents, o.currency)));
          const actTd = document.createElement('td');
          if (o.status === 'paid' && o.card_code) {
            const rb = document.createElement('button');
            rb.className = 'btn-tiny';
            rb.textContent = 'Resend email';
            rb.onclick = async () => {
              const orig = rb.textContent;
              rb.disabled = true; rb.textContent = 'Sending…';
              try {
                const r = await fetch('/api/account/resend', {
                  method: 'POST', credentials: 'same-origin',
                  headers: { 'content-type': 'application/json' },
                  body: JSON.stringify({ orderId: o.id }),
                });
                const d = await r.json().catch(() => ({}));
                if (!r.ok) throw new Error(d.message || d.code || ('HTTP ' + r.status));
                rb.textContent = 'Sent ✓';
                setTimeout(() => { rb.textContent = orig; }, 1800);
              } catch (e) {
                showBuyError('Resend failed: ' + e.message);
                rb.textContent = orig;
              } finally {
                rb.disabled = false;
              }
            };
            actTd.appendChild(rb);
          }
          tr.appendChild(actTd);
          tbody.appendChild(tr);
        }
        $('orders-empty').hidden = true;
        $('orders-table').hidden = false;
      } catch {
        $('orders-empty').hidden = false;
        $('orders-empty').textContent = 'Could not load your orders. Please refresh.';
        $('orders-table').hidden = true;
      }
    }

    /* ───────────────────────── Init ─────────────── */

    async function init() {
      let me;
      try {
        me = await (await fetch('/api/auth/me', { credentials: 'same-origin' })).json();
      } catch { me = { user: null }; }

      if (!me || !me.user) {
        location.replace('/login?redirect=/account');
        return;
      }

      const u = me.user;
      userEmail = u.email || '';
      $('acct-name').textContent = u.name || 'My account';
      $('acct-email').textContent = u.email || '';
      if (u.picture) { $('acct-pic').src = u.picture; $('acct-pic').hidden = false; }
      if (u.role === 'admin') $('admin-link').hidden = false;

      $('loading').hidden = true;
      $('account').hidden = false;

      renderBuyGrid();
      setupRecharge();
      wireModals();
      loadOrders();
      loadBalance().then((hasPending) => { if (hasPending) ensurePolling(); });

      // Resume polling promptly when the tab becomes visible again.
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden && (!$('recharge-box').hidden || prevDeposits.size)) ensurePolling();
      });
    }

    $('logout-btn').onclick = async () => {
      try { await fetch('/api/auth/logout', { method: 'POST', credentials: 'same-origin' }); } catch {}
      location.replace('/login');
    };

    init();
  </script>

