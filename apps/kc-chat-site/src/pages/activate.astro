---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout
  title="Activate your card | KC Chat"
  description="Paste your KC Chat card-key into the plugin's Activation panel to activate your license."
>
  <section class="section">
    <div class="container activate-page">
      <header class="hero">
        <p class="eyebrow">Activation</p>
        <h1>Activate your card in the KC&nbsp;Chat plugin</h1>
        <p class="lead">
          Your card-key activates <strong>inside Cursor</strong> — there's no website form.
          Copy your code, then paste it into the KC&nbsp;Chat panel.
        </p>
      </header>

      <div class="card code-card" id="code-card" hidden>
        <span class="field__label">Your card-key</span>
        <div class="code-row">
          <code class="card-code" id="card-code">KC-XXXX-XXXX-XXXX</code>
          <button class="copy-btn" id="copy-btn" type="button">Copy</button>
        </div>
        <p class="field__hint">Keep this safe — it binds to one device on first activation.</p>
      </div>

      <ol class="steps">
        <li><strong>Copy your card-key.</strong> It's in your purchase email and on the order-success page (format <code>KC-XXXX-XXXX-XXXX</code>).</li>
        <li>Open <strong>Cursor</strong> and show the <strong>KC&nbsp;Chat</strong> panel.</li>
        <li>Go to <strong>Settings → Activation</strong> inside the panel.</li>
        <li>Paste your card-key and click <strong>Activate</strong>.</li>
        <li>The panel shows <em>Activated · expires YYYY-MM-DD</em> — you're done. <span class="muted">(Day pass = 24&nbsp;h from activation.)</span></li>
      </ol>

      <div class="howto">
        <p><strong>Don't have the plugin yet?</strong> Follow the <a href="/tutorial">setup guide</a> to install KC&nbsp;Chat first, then come back and activate.</p>
        <p>Lost your card-key, or need to move it to a new device? <a href="/contact">Contact support</a>.</p>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      // Prefill the buyer's card code when arriving from the email / order-success page (?code=KC-…).
      try {
        var pre = new URLSearchParams(location.search).get('code');
        if (pre) {
          var card = document.getElementById('code-card');
          var code = document.getElementById('card-code');
          if (card && code) { code.textContent = pre.trim().toUpperCase(); card.hidden = false; }
        }
      } catch (_) { /* noop */ }

      var btn = document.getElementById('copy-btn');
      if (btn) {
        btn.addEventListener('click', async function () {
          var el = document.getElementById('card-code');
          var c = (el && el.textContent) || '';
          try {
            await navigator.clipboard.writeText(c);
            btn.textContent = 'Copied ✓';
            setTimeout(function () { btn.textContent = 'Copy'; }, 1600);
          } catch (_) {
            var r = document.createRange();
            r.selectNode(el);
            var sel = window.getSelection();
            sel.removeAllRanges(); sel.addRange(r);
          }
        });
      }
    })();
  </script>

  <style>
    .activate-page { max-width: 720px; }
    .hero { text-align: center; margin-block: 0 2rem; }
    .hero h1 { font-size: clamp(1.75rem, 4vw, 2.5rem); margin: 0.5rem 0 0.75rem; }
    .eyebrow {
      display: inline-flex; align-items: center;
      font-family: var(--font-mono); font-size: 0.78rem;
      color: var(--color-accent); font-weight: 500;
    }
    .eyebrow::before { content: '> '; white-space: pre; opacity: 0.55; font-weight: 700; }
    .lead { color: var(--text-secondary); max-width: 38em; margin-inline: auto; line-height: 1.6; }

    .card {
      background: var(--bg-card); border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg); padding: clamp(1.25rem, 3vw, 1.75rem);
      box-shadow: var(--shadow-card);
    }
    .code-card { display: grid; gap: 0.6rem; margin-bottom: 1.75rem; }
    .field__label { font-weight: 600; font-size: 0.95rem; }
    .field__hint { font-size: 0.8rem; color: var(--text-muted); margin: 0; }
    .code-row { display: flex; gap: 0.6rem; align-items: stretch; flex-wrap: wrap; }
    .card-code {
      flex: 1; min-width: 220px;
      font-family: var(--font-mono); font-size: clamp(1.05rem, 3vw, 1.4rem); font-weight: 700;
      letter-spacing: 0.04em; color: var(--color-accent);
      background: var(--color-accent-subtle);
      border: 1px dashed var(--border-accent); border-radius: var(--radius-md);
      padding: 0.8rem 1rem; display: flex; align-items: center; justify-content: center; user-select: all;
    }
    .copy-btn {
      font-family: var(--font-mono); font-weight: 600; font-size: 0.85rem;
      color: #fff; background: var(--color-accent); border: none;
      border-radius: var(--radius-md); padding: 0 1.1rem; cursor: pointer; transition: background 0.2s;
    }
    .copy-btn:hover { background: var(--color-accent-hover); }

    .steps {
      counter-reset: step; list-style: none; padding: 0; margin: 0 0 2rem;
      display: grid; gap: 0.85rem;
    }
    .steps li {
      position: relative; padding: 0.9rem 1rem 0.9rem 3.1rem;
      background: var(--bg-card); border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md); color: var(--text-secondary); line-height: 1.55;
    }
    .steps li::before {
      counter-increment: step; content: counter(step);
      position: absolute; left: 0.85rem; top: 0.85rem;
      width: 1.6rem; height: 1.6rem; border-radius: 50%;
      background: var(--color-accent); color: #fff;
      font-weight: 700; font-size: 0.85rem;
      display: flex; align-items: center; justify-content: center;
    }
    .steps strong { color: var(--text-primary); }
    .steps .muted { color: var(--text-muted); font-size: 0.88em; }

    .howto {
      padding: 1rem 1.25rem; background: var(--color-accent-subtle);
      border-radius: var(--radius-md);
    }
    .howto p { margin: 0.4rem 0; color: var(--text-secondary); font-size: 0.93rem; }
    .howto a { color: var(--color-accent); font-weight: 600; }
    code { font-family: var(--font-mono); font-size: 0.9em; background: #F1F5F9; padding: 0 0.25em; border-radius: 4px; }
  </style>
</BaseLayout>
