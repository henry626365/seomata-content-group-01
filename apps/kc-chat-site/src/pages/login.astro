---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout title="Sign in — KC Chat" description="Sign in to KC Chat with your Google account to view your orders and card-keys.">
  <section class="section">
    <div class="container auth-wrap">
      <div class="card auth-card">
        <h1>Sign in</h1>
        <p class="sub">Use your Google account to access your orders and card-keys.</p>

        <p id="auth-error" class="auth-error" hidden></p>

        <a id="google-btn" class="google-btn" href="/api/auth/google/start?redirect=/account">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
            <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.71-1.57 2.68-3.88 2.68-6.62z"/>
            <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.81.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18z"/>
            <path fill="#FBBC05" d="M3.97 10.72a5.41 5.41 0 0 1 0-3.44V4.95H.96a9 9 0 0 0 0 8.1l3.01-2.33z"/>
            <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58A9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58z"/>
          </svg>
          <span>Continue with Google</span>
        </a>

        <p class="fine">By signing in you agree to our <a href="/terms">Terms</a> and <a href="/privacy">Privacy Policy</a>.</p>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const params = new URLSearchParams(location.search);
      const err = params.get('error');
      if (err) {
        const el = document.getElementById('auth-error');
        const msg = {
          oauth_unconfigured: 'Google login is not configured yet. Please try again later.',
          bad_state: 'Your sign-in session expired. Please try again.',
          missing_code: 'Sign-in was cancelled or incomplete.',
          missing_verifier: 'Your sign-in session expired. Please try again.',
          email_unverified: 'Your Google email is not verified.',
          exchange_failed: 'Could not complete sign-in with Google. Please try again.',
          access_denied: 'Sign-in was cancelled.',
        }[err] || ('Sign-in failed: ' + err);
        el.textContent = msg;
        el.hidden = false;
      }
      // Preserve a ?redirect= target through the Google flow.
      const redirect = params.get('redirect');
      if (redirect && redirect.startsWith('/') && !redirect.startsWith('//')) {
        const btn = document.getElementById('google-btn');
        btn.href = '/api/auth/google/start?redirect=' + encodeURIComponent(redirect);
      }
      // If already logged in, skip straight to the account page.
      fetch('/api/auth/me', { credentials: 'same-origin' })
        .then((r) => r.json())
        .then((d) => { if (d && d.user) location.replace(redirect && redirect.startsWith('/') ? redirect : '/account'); })
        .catch(() => {});
    })();
  </script>

  <style>
    .auth-wrap { max-width: 460px; }
    .auth-card { text-align: center; }
    .auth-card h1 { margin: 0 0 0.5rem; }
    .auth-card .sub { color: var(--text-secondary); margin: 0 0 1.5rem; }
    .card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: clamp(1.5rem, 4vw, 2.5rem);
      box-shadow: var(--shadow-card);
    }
    .google-btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 0.65rem;
      width: 100%; padding: 0.7rem 1rem;
      border: 1px solid var(--border-subtle); border-radius: var(--radius-sm);
      background: #fff; color: #1f2937; font-weight: 600; font-size: 0.95rem;
      text-decoration: none; transition: box-shadow 0.2s, border-color 0.2s;
    }
    .google-btn:hover { box-shadow: var(--shadow-card); border-color: var(--text-muted); }
    .auth-error {
      background: #FEF2F2; color: #B91C1C; border: 1px solid #FECACA;
      border-radius: var(--radius-sm); padding: 0.6rem 0.8rem; font-size: 0.85rem; margin: 0 0 1rem;
    }
    .fine { font-size: 0.75rem; color: var(--text-muted); margin: 1.25rem 0 0; }
    .fine a { color: var(--text-secondary); }
  </style>
</BaseLayout>
