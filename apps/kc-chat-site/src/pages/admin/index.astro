---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
---

<BaseLayout title="Admin — KC Chat" description="Card-key admin dashboard (private).">
  <section class="section">
    <div class="container admin-page">
      <h1>Admin · Cards</h1>

      <div class="card auth" id="auth-panel">
        <div id="signed-in" class="signed-in" hidden>
          <img id="si-pic" class="si-pic" alt="" hidden />
          <div class="si-meta">
            <strong id="si-name">Signed in</strong>
            <span id="si-email" class="field__hint"></span>
          </div>
          <button id="si-logout" class="btn-ghost" type="button">Sign out</button>
        </div>

        <div id="signin-options">
          <a id="google-signin" class="google-btn" href="/api/auth/google/start?redirect=/admin">
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
              <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.71-1.57 2.68-3.88 2.68-6.62z"/>
              <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.81.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18z"/>
              <path fill="#FBBC05" d="M3.97 10.72a5.41 5.41 0 0 1 0-3.44V4.95H.96a9 9 0 0 0 0 8.1l3.01-2.33z"/>
              <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58A9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58z"/>
            </svg>
            <span>Sign in with Google</span>
          </a>
          <p class="field__hint" style="margin:0.6rem 0 1rem;">Admins (emails in <code>ADMIN_EMAILS</code>) sign in with Google — no token needed.</p>

          <details class="token-fallback">
            <summary>Use admin token instead</summary>
            <label class="field" style="margin-top:0.75rem;">
              <span class="field__label">Admin token</span>
              <input type="password" id="token-input" placeholder="Bearer token" autocomplete="off" />
            </label>
            <div class="row" style="margin-top:0.6rem;">
              <button id="auth-save" class="btn-primary">Save & load</button>
              <button id="auth-clear" class="btn-ghost" type="button">Clear stored</button>
            </div>
            <p class="field__hint">Token is stored in <code>localStorage.kc_admin_token</code> on your browser.</p>
          </details>
        </div>
      </div>

      <section class="card" id="gen-panel" hidden>
        <h2>Import card-keys</h2>
        <p class="field__hint" style="margin:-0.5rem 0 1rem;">
          Paste card-keys <strong>generated on kk-license</strong> to add them as sellable stock.
          h540 never generates codes — it only sells imported ones. Existing codes are skipped.
        </p>
        <div class="grid">
          <label class="field">
            <span class="field__label">Tier</span>
            <select id="gen-tier">
              <option value="day">Day Pass · 日卡 ($5 / 24h)</option>
              <option value="month">Monthly · 月卡 (30 days)</option>
              <option value="year" selected>Yearly · 年卡 (365 days)</option>
              <option value="lifetime">Lifetime · 终身 (100 years)</option>
              <option value="lite">Lite · 轻享月卡 ($10 / 30d)</option>
            </select>
          </label>
          <label class="field">
            <span class="field__label">Notes (optional)</span>
            <input type="text" id="gen-notes" placeholder="e.g. kk-license batch 2026-06" />
          </label>
        </div>
        <label class="field" style="margin-top:1rem;">
          <span class="field__label">Card-keys <small>(one per line, or comma/space separated)</small></span>
          <textarea id="gen-codes" rows="8" placeholder="KC-A1B2-C3D4-E5F6&#10;KC-G7H8-J9K0-L1M2&#10;..."></textarea>
        </label>
        <button id="gen-btn" class="btn-primary">Import</button>
        <pre id="gen-out" class="codeblock" hidden></pre>
      </section>

      <section class="card" id="list-panel" hidden>
        <header class="row" style="justify-content:space-between; align-items:end;">
          <h2 style="margin:0;">Cards</h2>
          <div class="row" style="gap:0.5rem;">
            <select id="list-status">
              <option value="">All status</option>
              <option value="unused">In stock</option>
              <option value="sold">Sold</option>
              <option value="revoked">Revoked</option>
            </select>
            <button id="del-selected" class="btn-ghost btn-ghost--danger" type="button" disabled>Delete selected (0)</button>
            <button id="del-filtered" class="btn-ghost btn-ghost--danger" type="button" hidden>Delete all filtered</button>
            <button id="list-reload" class="btn-ghost" type="button">Reload</button>
          </div>
        </header>
        <div id="list-stats" class="stats"></div>
        <div class="table-wrap">
          <table id="list-table" class="table">
            <thead>
              <tr>
                <th class="col-sel"><input type="checkbox" id="sel-all" title="Select all" /></th>
                <th>Code</th><th>Tier</th><th>Status</th>
                <th>Imported</th><th>Sold</th>
                <th>Notes</th><th>Action</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </section>
    </div>
  </section>

  <script is:inline>
    const $ = (id) => document.getElementById(id);
    const STORAGE = 'kc_admin_token';
    let token = localStorage.getItem(STORAGE) || '';
    let googleUser = null;

    function authed() { return !!token || !!googleUser; }

    function reveal() {
      const on = authed();
      $('gen-panel').hidden = !on;
      $('list-panel').hidden = !on;
      // Swap the sign-in options ↔ the signed-in summary.
      $('signin-options').hidden = on;
      $('signed-in').hidden = !on;
    }

    function showGoogleSignedIn(u) {
      $('si-name').textContent = u.name || 'Signed in (admin)';
      $('si-email').textContent = u.email || '';
      if (u.picture) { $('si-pic').src = u.picture; $('si-pic').hidden = false; }
    }

    function showTokenSignedIn() {
      $('si-name').textContent = 'Signed in with admin token';
      $('si-email').textContent = '';
      $('si-pic').hidden = true;
    }

    async function init() {
      if (token) { $('token-input').value = token; showTokenSignedIn(); reveal(); loadList(); return; }
      // No token → check for a Google admin session.
      try {
        const me = await (await fetch('/api/auth/me', { credentials: 'same-origin' })).json();
        if (me && me.user && me.user.role === 'admin') {
          googleUser = me.user;
          showGoogleSignedIn(me.user);
          reveal();
          loadList();
        }
      } catch {}
    }

    $('auth-save').onclick = () => {
      token = $('token-input').value.trim();
      if (!token) return alert('paste a token');
      localStorage.setItem(STORAGE, token);
      showTokenSignedIn();
      reveal();
      loadList();
    };
    $('auth-clear').onclick = () => {
      localStorage.removeItem(STORAGE);
      token = '';
      $('token-input').value = '';
      reveal();
    };
    $('si-logout').onclick = async () => {
      // Clear the local token (if any) and the server session (if any), then reload.
      if (token) { localStorage.removeItem(STORAGE); token = ''; }
      if (googleUser) { try { await fetch('/api/auth/logout', { method: 'POST', credentials: 'same-origin' }); } catch {} }
      location.reload();
    };

    async function api(path, opts = {}) {
      const headers = { 'content-type': 'application/json', ...(opts.headers || {}) };
      if (token) headers['authorization'] = 'Bearer ' + token; // else rely on session cookie
      const res = await fetch(path, { ...opts, credentials: 'same-origin', headers });
      let data = {};
      try { data = await res.json(); } catch {}
      if (!res.ok) throw new Error((data && (data.message || data.code)) || ('HTTP ' + res.status));
      return data;
    }

    $('gen-btn').onclick = async () => {
      const codes = $('gen-codes').value || '';
      if (!codes.trim()) { alert('Paste some card-keys first'); return; }
      try {
        const data = await api('/api/admin/import', {
          method: 'POST',
          body: JSON.stringify({
            tier: $('gen-tier').value,
            codes,
            notes: $('gen-notes').value || undefined,
          }),
        });
        $('gen-out').hidden = false;
        $('gen-out').textContent =
          `Imported ${data.imported} ${data.tier_label || data.tier} card(s)` +
          `  ·  duplicates skipped: ${data.duplicates}` +
          `  ·  invalid: ${data.invalid}` +
          `  ·  batch: ${data.batch_id}`;
        $('gen-codes').value = '';
        await loadList();
      } catch (e) {
        alert('Import failed: ' + e.message);
      }
    };

    $('list-status').onchange = loadList;
    $('list-reload').onclick = loadList;

    function selectedCodes() {
      return Array.from(document.querySelectorAll('.row-sel:checked')).map((b) => b.dataset.code);
    }
    function updateSelection() {
      const boxes = Array.from(document.querySelectorAll('.row-sel'));
      const checked = boxes.filter((b) => b.checked);
      const btn = $('del-selected');
      btn.textContent = 'Delete selected (' + checked.length + ')';
      btn.disabled = checked.length === 0;
      const all = $('sel-all');
      all.checked = boxes.length > 0 && checked.length === boxes.length;
      all.indeterminate = checked.length > 0 && checked.length < boxes.length;
    }

    $('sel-all').onchange = () => {
      const on = $('sel-all').checked;
      document.querySelectorAll('.row-sel').forEach((b) => { b.checked = on; });
      updateSelection();
    };

    $('del-selected').onclick = async () => {
      const codes = selectedCodes();
      if (codes.length === 0) return;
      if (!confirm('Permanently DELETE ' + codes.length + ' selected card-key(s)? This cannot be undone.')) return;
      try {
        let data = await api('/api/admin/delete', { method: 'POST', body: JSON.stringify({ codes }) });
        // Sold cards are skipped unless forced — offer a second pass.
        if (data.skipped_sold && data.skipped_sold.length) {
          if (confirm(data.deleted + ' deleted. ' + data.skipped_sold.length +
            ' are SOLD (linked to orders) and were skipped. Force delete those too?')) {
            const d2 = await api('/api/admin/delete', { method: 'POST', body: JSON.stringify({ codes: data.skipped_sold, force: true }) });
            data = { deleted: data.deleted + d2.deleted, skipped_sold: [], not_found: (data.not_found || []).concat(d2.not_found || []) };
          }
        }
        const nf = (data.not_found && data.not_found.length) ? ('  ·  not found: ' + data.not_found.length) : '';
        alert('Deleted ' + data.deleted + ' card-key(s)' + nf);
        await loadList();
      } catch (e) { alert(e.message); }
    };

    $('del-filtered').onclick = async () => {
      const status = $('del-filtered').dataset.status;
      if (!status) return;
      const lbl = { unused: 'In stock', sold: 'Sold', revoked: 'Revoked' };
      const name = lbl[status] || status;
      if (!confirm("Permanently DELETE ALL cards with status '" + name + "'? This cannot be undone.")) return;
      const payload = { status };
      if (status === 'sold') {
        if (!confirm('These are SOLD cards linked to orders. Force delete ALL of them?')) return;
        payload.force = true;
      }
      try {
        const data = await api('/api/admin/delete', { method: 'POST', body: JSON.stringify(payload) });
        alert("Deleted " + data.deleted + " card-key(s) with status '" + name + "'");
        await loadList();
      } catch (e) { alert(e.message); }
    };

    async function loadList() {
      try {
        const status = $('list-status').value;
        const qs = status ? `?status=${encodeURIComponent(status)}` : '';
        const data = await api('/api/admin/cards' + qs);
        $('list-stats').textContent =
          'Total: ' + data.total + '  ·  ' +
          Object.entries(data.stats || {}).map(([k, v]) => k + ': ' + v).join('  ·  ');
        // "Delete all filtered" — only when a concrete status filter is active.
        const delF = $('del-filtered');
        const statusLbl = { unused: 'In stock', sold: 'Sold', revoked: 'Revoked' };
        if (status) {
          delF.hidden = false;
          delF.disabled = !data.total;
          delF.textContent = "Delete all '" + (statusLbl[status] || status) + "' (" + data.total + ')';
          delF.dataset.status = status;
        } else {
          delF.hidden = true;
          delF.dataset.status = '';
        }
        const tbody = $('list-table').querySelector('tbody');
        tbody.innerHTML = '';
        $('sel-all').checked = false;
        $('sel-all').indeterminate = false;
        for (const c of data.items) {
          const tr = document.createElement('tr');
          const cell = (txt, mono) => {
            const td = document.createElement('td');
            if (mono) td.className = 'mono';
            td.textContent = txt;
            return td;
          };
          const fmt = (t) => (t ? new Date(t).toISOString().slice(0, 16).replace('T', ' ') : '—');
          const statusLabel = { unused: 'In stock', sold: 'Sold', revoked: 'Revoked' };
          const selTd = document.createElement('td');
          selTd.className = 'col-sel';
          const selBox = document.createElement('input');
          selBox.type = 'checkbox';
          selBox.className = 'row-sel';
          selBox.dataset.code = c.code;
          selBox.onchange = updateSelection;
          selTd.appendChild(selBox);
          tr.appendChild(selTd);
          tr.appendChild(cell(c.code, true));
          tr.appendChild(cell(c.tier));
          tr.appendChild(cell(statusLabel[c.status] || c.status));
          tr.appendChild(cell(fmt(c.generated_at)));
          tr.appendChild(cell(fmt(c.sold_at)));
          tr.appendChild(cell(c.notes || '—'));
          const td = document.createElement('td');
          // h540 doesn't activate cards, so there's no device-transfer here.
          // Revoke = pull an unsold card from sale.
          if (c.status === 'unused') {
            const b2 = document.createElement('button');
            b2.className = 'btn-tiny btn-tiny--danger';
            b2.textContent = 'Revoke';
            b2.onclick = async () => {
              if (!confirm('Pull ' + c.code + ' from sale (revoke)?')) return;
              try {
                await api('/api/admin/revoke', { method: 'POST', body: JSON.stringify({ code: c.code }) });
                await loadList();
              } catch (e) { alert(e.message); }
            };
            td.appendChild(b2);
          }
          // Delete = permanently remove the card-key row (any status).
          const bDel = document.createElement('button');
          bDel.className = 'btn-tiny btn-tiny--danger';
          bDel.textContent = 'Delete';
          bDel.onclick = async () => {
            if (!confirm('Permanently DELETE ' + c.code + '? This cannot be undone.')) return;
            try {
              await api('/api/admin/delete', { method: 'POST', body: JSON.stringify({ code: c.code }) });
              await loadList();
            } catch (e) {
              // Sold cards are linked to an order — backend asks for explicit force.
              if (/sold/i.test(e.message)) {
                if (confirm(c.code + ' is SOLD (linked to an order). Force delete anyway?')) {
                  try {
                    await api('/api/admin/delete', { method: 'POST', body: JSON.stringify({ code: c.code, force: true }) });
                    await loadList();
                    return;
                  } catch (e2) { alert(e2.message); return; }
                }
                return;
              }
              alert(e.message);
            }
          };
          td.appendChild(bDel);
          tr.appendChild(td);
          tbody.appendChild(tr);
        }
        updateSelection();
      } catch (e) {
        alert('List failed: ' + e.message);
      }
    }

    init();
  </script>

  <style>
    .admin-page { max-width: 1100px; }
    .admin-page h1 { margin-bottom: 1.5rem; }
    .card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: clamp(1rem, 2.5vw, 1.75rem);
      box-shadow: var(--shadow-card);
      margin-bottom: 1.5rem;
    }
    .card h2 { font-size: 1.15rem; margin: 0 0 1rem; }
    .row { display: flex; gap: 0.75rem; align-items: center; }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 1rem;
      margin-bottom: 1rem;
    }
    .field { display: grid; gap: 0.35rem; }
    .field__label { font-weight: 600; font-size: 0.9rem; }
    .field__hint { font-size: 0.78rem; color: var(--text-muted); }
    input, select, textarea {
      padding: 0.55rem 0.7rem;
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      font-size: 0.95rem;
      font-family: inherit;
      background: #fff;
    }
    input[type='password'], input[type='text'], textarea { font-family: var(--font-mono); }
    textarea { width: 100%; resize: vertical; line-height: 1.5; }
    .btn-primary {
      background: var(--color-accent); color: #fff; border: 0;
      padding: 0.55rem 1rem; border-radius: var(--radius-sm); font-weight: 600; cursor: pointer;
    }
    .btn-primary:hover { background: var(--color-accent-hover); }
    .btn-ghost {
      background: transparent; color: var(--text-secondary); border: 1px solid var(--border-subtle);
      padding: 0.5rem 0.9rem; border-radius: var(--radius-sm); cursor: pointer;
    }
    .btn-ghost--danger { color: #B91C1C; border-color: #FECACA; }
    .btn-ghost--danger:hover:not(:disabled) { background: #FEF2F2; }
    .btn-ghost:disabled { opacity: 0.5; cursor: not-allowed; }
    .col-sel { width: 1%; text-align: center; white-space: nowrap; }
    .col-sel input { width: auto; }
    .btn-tiny {
      background: var(--color-accent-subtle); color: var(--color-accent);
      border: 1px solid var(--border-accent);
      padding: 0.2rem 0.55rem; border-radius: 6px; font-size: 0.78rem; cursor: pointer; margin-right: 0.25rem;
    }
    .btn-tiny--danger {
      background: #FEF2F2; color: #B91C1C; border-color: #FECACA;
    }
    .codeblock {
      background: var(--bg-code); color: #E2E8F0;
      padding: 0.85rem; border-radius: var(--radius-sm); font-family: var(--font-mono);
      font-size: 0.78rem; max-height: 280px; overflow: auto; white-space: pre-wrap; word-break: break-all;
      margin-top: 1rem;
    }
    .google-btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem;
      padding: 0.6rem 1.1rem; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm);
      background: #fff; color: #1f2937; font-weight: 600; font-size: 0.92rem;
      text-decoration: none; transition: box-shadow 0.2s, border-color 0.2s;
    }
    .google-btn:hover { box-shadow: var(--shadow-card); border-color: var(--text-muted); }
    .token-fallback summary { cursor: pointer; font-size: 0.82rem; color: var(--text-secondary); }
    .token-fallback[open] summary { margin-bottom: 0.25rem; }
    .signed-in { display: flex; align-items: center; gap: 0.75rem; }
    .si-pic { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; }
    .si-meta { display: flex; flex-direction: column; line-height: 1.3; margin-right: auto; }
    .stats { font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.75rem; }
    .table-wrap { overflow-x: auto; }
    .table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    .table th, .table td {
      padding: 0.5rem 0.6rem; border-bottom: 1px solid var(--border-subtle); text-align: left;
      white-space: nowrap;
    }
    .table th { background: #F8FAFC; font-weight: 600; }
    .mono { font-family: var(--font-mono); }
  </style>
</BaseLayout>
