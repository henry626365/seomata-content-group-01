---
type Props = {
	href: string;
	title: string;
	description: string;
	image: string;
	imageAlt: string;
	category: string;
	variant?: 'featured' | 'sideFeature' | 'archive' | 'homeResource' | 'hubResource' | 'default';
};

const { href, title, description, image, imageAlt, category, variant = 'default' } = Astro.props;
---

<a
	class:list={['article-card', variant]}
	href={href}
	aria-label={`Read guide: ${title}`}
>
	<div class="media">
		<img src={image} alt={imageAlt} loading="lazy" width="800" height="450" />
		<span class="tag">{category}</span>
	</div>
	<div class="body">
		<h3>{title}</h3>
		<p>{description}</p>
	</div>
</a>

<style>
	.article-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		background: #fff;
		border: 1px solid #cfe1ef;
		border-radius: 20px;
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		box-shadow: 0 2px 8px rgba(11, 53, 85, 0.06);
		transition:
			border-color 0.2s ease,
			box-shadow 0.22s ease,
			transform 0.22s ease;
	}
	.article-card:hover {
		border-color: #9ec4e8;
		box-shadow: 0 16px 40px rgba(11, 53, 85, 0.1);
		transform: translateY(-4px);
	}
	.media {
		position: relative;
		aspect-ratio: 16 / 9;
		background: linear-gradient(160deg, #eef5fb 0%, #e3f0fa 100%);
		overflow: hidden;
	}
	.media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 38%;
		display: block;
	}
	.tag {
		position: absolute;
		top: 0.75rem;
		left: 0.75rem;
		background: rgba(255, 255, 255, 0.94);
		color: #0b3555;
		font-size: 0.72rem;
		font-weight: 700;
		padding: 0.35rem 0.75rem;
		border-radius: 999px;
		border: 1px solid rgba(11, 53, 85, 0.08);
		box-shadow: 0 2px 8px rgba(11, 53, 85, 0.06);
	}
	.body {
		padding: 1rem 1.1rem 1.15rem;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		flex: 1;
	}
	h3 {
		margin: 0;
		font-size: 1.02rem;
		line-height: 1.32;
		color: #0b3555;
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	p {
		margin: 0;
		font-size: 0.87rem;
		line-height: 1.55;
		color: #4a6b82;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.featured .media {
		aspect-ratio: 1.95 / 1;
	}
	.featured .body {
		padding: 1.35rem 1.4rem 1.5rem;
		gap: 0.65rem;
	}
	.featured h3 {
		font-size: clamp(1.55rem, 2.6vw, 1.95rem);
		line-height: 1.14;
		font-weight: 800;
		transition: color 0.2s ease;
	}
	.featured p {
		font-size: clamp(1.02rem, 1.35vw, 1.12rem);
		line-height: 1.58;
		color: #315a72;
		-webkit-line-clamp: 3;
		transition: color 0.2s ease;
	}
	.featured .tag {
		font-size: 0.78rem;
	}
	.featured:hover h3,
	.featured:hover p {
		color: #0b63b6;
	}
	.sideFeature {
		border-radius: 16px;
		box-shadow: 0 1px 4px rgba(11, 53, 85, 0.045);
	}
	.sideFeature:hover {
		border-color: #74abd8;
		box-shadow: 0 10px 24px rgba(11, 53, 85, 0.08);
		transform: translateY(-3px);
	}
	.sideFeature .media {
		aspect-ratio: 2.3 / 1;
	}
	.sideFeature .body {
		padding: 1rem 1.05rem 1.1rem;
		gap: 0.45rem;
	}
	.sideFeature h3 {
		font-size: clamp(1.06rem, 1.25vw, 1.18rem);
		line-height: 1.24;
		font-weight: 800;
		transition: color 0.2s ease;
	}
	.sideFeature p {
		font-size: clamp(0.92rem, 1vw, 0.98rem);
		line-height: 1.55;
		color: #365f78;
		-webkit-line-clamp: 3;
		transition: color 0.2s ease;
	}
	.sideFeature .tag {
		font-size: 0.7rem;
	}
	.sideFeature:hover h3,
	.sideFeature:hover p {
		color: #0b63b6;
	}
	.archive .media {
		aspect-ratio: 2.25 / 1;
	}
	.archive .body {
		padding: 1.25rem 1.25rem 1.35rem;
		gap: 0.65rem;
	}
	.archive h3 {
		font-size: clamp(1.34rem, 2vw, 1.58rem);
		line-height: 1.18;
		font-weight: 800;
		letter-spacing: -0.025em;
		transition: color 0.2s ease;
	}
	.archive p {
		font-size: clamp(1.04rem, 1.3vw, 1.12rem);
		line-height: 1.58;
		color: #315a72;
		-webkit-line-clamp: 4;
		transition: color 0.2s ease;
	}
	.archive .tag {
		font-size: 0.76rem;
	}
	.archive:hover h3,
	.archive:hover p {
		color: #0b63b6;
	}
	.homeResource .media {
		aspect-ratio: 2.1 / 1;
	}
	.homeResource .body {
		padding: 1.1rem 1.15rem 1.25rem;
		gap: 0.5rem;
	}
	.homeResource h3 {
		font-size: clamp(1.12rem, 1.45vw, 1.24rem);
		line-height: 1.24;
		font-weight: 800;
		transition: color 0.2s ease;
	}
	.homeResource p {
		font-size: clamp(0.94rem, 1.12vw, 1rem);
		line-height: 1.58;
		color: #365f78;
		-webkit-line-clamp: 4;
		transition: color 0.2s ease;
	}
	.homeResource:hover h3,
	.homeResource:hover p {
		color: #0b63b6;
	}
	.hubResource {
		border-radius: 16px;
		box-shadow: 0 1px 4px rgba(11, 53, 85, 0.045);
	}
	.hubResource:hover {
		border-color: #74abd8;
		box-shadow: 0 12px 28px rgba(11, 53, 85, 0.085);
		transform: translateY(-3px);
	}
	.hubResource .media {
		aspect-ratio: 2.25 / 1;
	}
	.hubResource .body {
		padding: 1.15rem 1.18rem 1.25rem;
		gap: 0.55rem;
	}
	.hubResource h3 {
		font-size: clamp(1.18rem, 1.65vw, 1.35rem);
		line-height: 1.22;
		font-weight: 800;
		transition: color 0.2s ease;
	}
	.hubResource p {
		font-size: clamp(0.98rem, 1.18vw, 1.05rem);
		line-height: 1.6;
		color: #365f78;
		-webkit-line-clamp: 4;
		transition: color 0.2s ease;
	}
	.hubResource .tag {
		font-size: 0.74rem;
	}
	.hubResource:hover h3,
	.hubResource:hover p {
		color: #0b63b6;
	}
</style>
