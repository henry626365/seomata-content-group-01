---
import PageShell from '../../layouts/PageShell.astro';

const seoTitle = 'Contact | Med Spa Marketing Guide';
const seoDesc =
	'Signal corrections, citation issues, or partnership ideas—responses are asynchronous and informational only.';
---

<PageShell title={seoTitle} description={seoDesc}>
	<h1>Contact</h1>
	<p>
		Use your production inbox for typo reports, factual clarifications, or collaboration notes. This build ships
		without public mailto links so you avoid publishing broken addresses—we do not provide individualized medical,
		legal, HIPAA, crisis PR, or platform reinstatement counseling blindly through a web form anyway.
	</p>
	<p>
		Add a monitored contact workflow (ticket system, HIPAA-aware form vendor, etc.) during deployment; keep PHI out of
		unencrypted email trails.
	</p>
</PageShell>
