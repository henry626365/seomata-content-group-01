---
import PageShell from '../../layouts/PageShell.astro';

const seoTitle = 'About Med Spa Marketing Guide';
const seoDesc =
	'Educational marketing library for aesthetic practices—we publish frameworks, disclaimers-first safety notes, and no fabricated performance claims.';
---

<PageShell title={seoTitle} description={seoDesc}>
	<h1>About this site</h1>
	<p>
		Med Spa Marketing Guide is an independent editorial project focused on how U.S.-based aesthetic practices
		improve ethical digital discovery: Google Business Profile hygiene, modality-forward website structure,
		patient-reviewed trust signals, and consult capture mechanics.
	</p>
	<h2>What we are not</h2>
	<ul>
		<li>Not a substitute for HIPAA counsel, clinician judgment, advertising review, or platform policy teams.</li>
		<li>Not a rankings guarantee—we avoid fabricated SERP trophies and vanity dashboard theater.</li>
		<li>Not a staffing flex—we intentionally do not claim a large in-house consultancy bench.</li>
	</ul>
	<h2>Audience</h2>
	<p>
		Operators, coordinators, fractional marketers, designers, and partner agencies aligning creative direction with
		safe patient communication.
	</p>
</PageShell>
