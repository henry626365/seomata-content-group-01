---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import SiteFooter from '../components/home/SiteFooter.astro';

type Props = {
	title: string;
	description: string;
};

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body class="page-shell-body">
		<Header />
		<main class="shell-main">
			<article class="shell-article prose">
				<slot />
			</article>
		</main>
		<SiteFooter />
	</body>
</html>

<style>
	.page-shell-body {
		margin: 0;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		background: linear-gradient(180deg, #f4f9fc 0%, #f0f4f7 35%, #ffffff 100%);
		color: #1c3a4d;
	}
	.shell-main {
		flex: 1;
		width: min(820px, calc(100% - clamp(1.25rem, 5vw, 2.75rem)));
		margin: 0 auto;
		padding: clamp(1.5rem, 4vw, 2.75rem) 0 clamp(2.5rem, 6vw, 3.5rem);
	}
	.shell-article :global(h1) {
		margin: 0 0 0.75rem;
		font-size: clamp(1.55rem, 3vw, 2rem);
		color: #0b3555;
		line-height: 1.2;
	}
	.shell-article :global(p) {
		margin: 0 0 1rem;
		line-height: 1.7;
		color: #325a72;
		font-size: clamp(0.98rem, 1.4vw, 1.05rem);
	}
	.shell-article :global(ul) {
		margin: 0 0 1rem;
		padding-left: 1.25rem;
		color: #325a72;
		line-height: 1.65;
	}
	.shell-article :global(a) {
		color: #0b4f7a;
	}
</style>
