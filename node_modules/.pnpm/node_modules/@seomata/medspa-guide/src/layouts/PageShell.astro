---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import SiteFooter from '../components/home/SiteFooter.astro';

type Props = {
	title: string;
	description: string;
};

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body class="page-shell-body">
		<Header />
		<main class="shell-main">
			<article class="shell-article prose">
				<slot />
			</article>
		</main>
		<SiteFooter />
	</body>
</html>

<style>
	.page-shell-body {
		margin: 0;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		background: linear-gradient(180deg, #f4f9fc 0%, #f0f4f7 35%, #ffffff 100%);
		color: #1c3a4d;
	}
	.shell-main {
		flex: 1;
		width: min(980px, calc(100% - clamp(1.25rem, 5vw, 2.75rem)));
		margin: 0 auto;
		padding: clamp(1.5rem, 4vw, 2.75rem) 0 clamp(2.5rem, 6vw, 3.5rem);
	}
	.shell-article {
		background: #fff;
		border: 1px solid #e1edf6;
		border-radius: 20px;
		padding: clamp(1.25rem, 3vw, 2rem);
		box-shadow: 0 12px 40px rgba(11, 53, 85, 0.05);
	}
	.shell-article :global(h1) {
		margin: 0 0 0.75rem;
		font-size: clamp(1.55rem, 3vw, 2rem);
		color: #0b3555;
		line-height: 1.2;
	}
	.shell-article :global(p) {
		margin: 0 0 1rem;
		line-height: 1.7;
		color: #325a72;
		font-size: clamp(0.98rem, 1.4vw, 1.05rem);
	}
	.shell-article :global(h2) {
		margin: 1.6rem 0 0.75rem;
		color: #0b3555;
		font-size: clamp(1.2rem, 2vw, 1.45rem);
		line-height: 1.25;
	}
	.shell-article :global(h3) {
		margin: 1rem 0 0.45rem;
		color: #123c52;
		font-size: 1.02rem;
		line-height: 1.3;
	}
	.shell-article :global(ul) {
		margin: 0 0 1rem;
		padding-left: 1.25rem;
		color: #325a72;
		line-height: 1.65;
	}
	.shell-article :global(ol) {
		margin: 0 0 1rem;
		padding-left: 1.35rem;
		color: #325a72;
		line-height: 1.65;
	}
	.shell-article :global(a) {
		color: #0b4f7a;
	}
	.shell-article :global(blockquote) {
		margin: 0 0 1rem;
		border-left: 4px solid #d4a574;
		padding: 0.8rem 1rem;
		background: #fffaf5;
		color: #365f78;
		border-radius: 0 12px 12px 0;
	}
	.shell-article :global(table) {
		width: 100%;
		margin: 0 0 1.2rem;
		border-collapse: collapse;
		font-size: 0.92rem;
		color: #2f5470;
	}
	.shell-article :global(th),
	.shell-article :global(td) {
		border: 1px solid #d9e7f0;
		padding: 0.7rem 0.75rem;
		vertical-align: top;
	}
	.shell-article :global(th) {
		background: #f4f9fc;
		color: #0b3555;
		text-align: left;
	}
	.shell-article :global(.note-box),
	.shell-article :global(.example-box) {
		margin: 1rem 0;
		padding: 1rem 1.05rem;
		border: 1px solid #d9e7f0;
		border-radius: 14px;
		background: #f8fbff;
	}
	.shell-article :global(.warning-box) {
		margin: 1rem 0;
		padding: 1rem 1.05rem;
		border: 1px solid #ead3bb;
		border-left: 4px solid #d4a574;
		border-radius: 0 14px 14px 0;
		background: #fffaf5;
	}
</style>
