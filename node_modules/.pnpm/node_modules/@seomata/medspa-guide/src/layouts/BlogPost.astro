---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import SiteFooter from '../components/home/SiteFooter.astro';
import type { CollectionEntry } from 'astro:content';
import { encodePublicAssetPath } from '../utils/publicAsset';

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: { depth: number; slug: string; text: string }[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	heroPhoto,
	category,
	author,
	headings = [],
} = Astro.props;

const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const tocSlugs = toc.map((h) => h.slug);
const heroAlt = title;
const heroPhotoSrc = heroPhoto ? encodePublicAssetPath(heroPhoto) : undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			publicOgImage={heroImage ? undefined : heroPhoto}
		/>
		<style is:global>
			.blog-shell {
				margin: 0;
				min-height: 100vh;
				display: flex;
				flex-direction: column;
				background: linear-gradient(180deg, #f4f9fc 0%, #f0f4f7 40%, #ffffff 100%);
				color: #1c3a4d;
				overflow-x: clip;
			}
			.blog-inner {
				width: min(1120px, calc(100% - clamp(1.25rem, 5vw, 3rem)));
				margin: 0 auto;
				padding: clamp(1.25rem, 3vw, 2rem) 0 clamp(2.75rem, 6vw, 4rem);
			}
			.meta-row {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem 1rem;
				align-items: center;
				justify-content: center;
				margin-bottom: 0.35rem;
			}
			.pill {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				padding: 0.38rem 0.82rem;
				border-radius: 999px;
				font-weight: 700;
				font-size: 0.78rem;
				letter-spacing: 0.04em;
				text-transform: uppercase;
				color: #0b3555;
				background: #fff;
				border: 1px solid #cfe6f4;
				box-shadow: 0 2px 10px rgba(11, 53, 85, 0.05);
			}
			.date {
				color: #4f6f85;
				font-size: 0.92rem;
			}
			.last-updated-on {
				font-style: italic;
				color: #5c7890;
			}
			.blog-title {
				margin: 0 auto 1.25rem;
				max-width: 28ch;
				text-align: center;
				font-size: clamp(1.6rem, 3.8vw, 2.35rem);
				line-height: 1.2;
				color: #0b3555;
				letter-spacing: -0.03em;
				font-weight: 800;
			}
			.blog-hero {
				margin: 0 auto 1.5rem;
				max-width: 1020px;
				border-radius: 18px;
				overflow: hidden;
				border: 1px solid #d9e9f5;
				box-shadow: 0 18px 50px rgba(11, 53, 85, 0.1);
				background: #fff;
			}
			.blog-hero img.hero-photo {
				display: block;
				width: 100%;
				height: auto;
			}
			.blog-layout {
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(220px, 260px);
				gap: clamp(1.25rem, 3vw, 2rem);
				align-items: start;
			}
			.blog-layout-single {
				grid-template-columns: 1fr;
			}
			.toc {
				position: sticky;
				top: 5.75rem;
				border-radius: 16px;
				border: 1px solid #d4e7f6;
				background: #fff;
				padding: 1rem 1rem;
				box-shadow: 0 10px 32px rgba(11, 53, 85, 0.06);
			}
			.toc-title {
				margin: 0 0 0.65rem;
				font-size: 0.75rem;
				font-weight: 800;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: #3f6279;
			}
			.toc ul {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				gap: 0.45rem;
			}
			.toc a {
				display: inline-block;
				font-size: 0.87rem;
				line-height: 1.35;
				color: #1c4a62;
				text-decoration: none;
				border-bottom: 1px dashed rgba(11, 79, 120, 0.25);
			}
			.toc a:hover {
				color: #0b3555;
				border-bottom-color: rgba(11, 53, 85, 0.45);
			}
			.toc-depth-3 {
				padding-left: 0.75rem;
			}
			.prose-shell {
				background: #fff;
				border: 1px solid #e7f0fa;
				border-radius: 18px;
				padding: clamp(1rem, 2.8vw, 1.85rem);
				box-shadow: 0 12px 40px rgba(11, 53, 85, 0.05);
			}
			.prose {
				max-width: 720px;
				margin: 0 auto;
			}
			.prose :global(h2) {
				margin-top: 1.7rem;
				margin-bottom: 0.85rem;
				font-size: 1.28rem;
				color: #0b3555;
				line-height: 1.3;
			}
			.prose :global(h3) {
				margin-top: 1.3rem;
				margin-bottom: 0.6rem;
				font-size: 1.05rem;
				color: #123c52;
			}
			.prose :global(p),
			.prose :global(li) {
				color: #2f5470;
				line-height: 1.82;
				font-size: 1rem;
			}
			.prose :global(ul) {
				padding-left: 1.2rem;
			}
			.prose :global(blockquote) {
				border-left: 4px solid #d4a574;
				margin: 1rem 0;
				padding-left: 1rem;
				color: #3c5d74;
				font-style: italic;
			}
			.byline {
				margin-top: -0.5rem;
				margin-bottom: 1rem;
				text-align: center;
				color: #5c7890;
				font-size: 0.9rem;
			}
			.blog-description {
				margin: -0.65rem auto 1.25rem;
				max-width: 64ch;
				text-align: center;
				color: #385f78;
				font-size: clamp(0.98rem, 1.5vw, 1.08rem);
				line-height: 1.65;
			}
			@media (max-width: 960px) {
				.blog-layout {
					grid-template-columns: 1fr;
				}
				.toc {
					position: static;
				}
			}
			@media (max-width: 720px) {
				.blog-title {
					max-width: none;
				}
			}
		</style>
	</head>
	<body class="blog-shell">
		<Header />
		<main class="blog-inner">
			<article>
				<div class="meta-row">
					<span class="pill">{category}</span>
				</div>
				<p class="date">
					Published <FormattedDate date={pubDate} />
					{
						updatedDate && (
							<span class="last-updated-on">
								{' '}
								· Updated <FormattedDate date={updatedDate} />
							</span>
						)
					}
				</p>
				<h1 class="blog-title">{title}</h1>
				<p class="blog-description">{description}</p>
				{author && <p class="byline">{author}</p>}
				{
					heroImage ? (
						<div class="blog-hero">
							<Image width={1020} height={510} src={heroImage} alt={heroAlt} />
						</div>
					) : (
						heroPhotoSrc && (
							<div class="blog-hero">
								<img
									class="hero-photo"
									src={heroPhotoSrc}
									alt={heroAlt}
									width={1020}
									height={510}
									loading="eager"
								/>
							</div>
						)
					)
				}

				<div class:list={['blog-layout', toc.length === 0 && 'blog-layout-single']}>
					<div class="prose-shell">
						<div class="prose">
							<slot />
						</div>
					</div>

					{
						toc.length > 0 && (
							<nav class="toc" aria-label="On this page">
								<p class="toc-title">On this page</p>
								<ul>
									{toc.map((heading) => (
										<li
											class:list={[
												heading.depth === 3 ? 'toc-depth-3' : '',
											]}
										>
											<a href={`#${heading.slug}`}>{heading.text}</a>
										</li>
									))}
								</ul>
							</nav>
						)
					}
				</div>
			</article>
		</main>
		<SiteFooter />
		<script define:vars={{ tocSlugs }}>
			const articleHeadings = Array.from(document.querySelectorAll('.prose h2, .prose h3'));
			articleHeadings.forEach((heading, index) => {
				const slug = tocSlugs[index];
				if (slug) heading.id = slug;
			});
		</script>
	</body>
</html>
