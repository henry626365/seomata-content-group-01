---
type Props = {
	title: string;
	description?: string;
	headingId?: string;
};

const { title, description, headingId } = Astro.props;
---

<div class="section-header">
	<h2 {...headingId ? { id: headingId } : {}}>{title}</h2>
	{description && <p class="desc">{description}</p>}
</div>

<style>
	.section-header {
		margin-bottom: clamp(1.2rem, 3vw, 1.65rem);
	}
	h2 {
		margin: 0 0 0.5rem;
		font-size: clamp(1.25rem, 2.5vw, 1.65rem);
		color: var(--ink);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.25;
	}
	.desc {
		margin: 0;
		max-width: 62ch;
		font-size: clamp(0.94rem, 1.4vw, 1.02rem);
		line-height: 1.65;
		color: var(--ink-muted);
	}
</style>
