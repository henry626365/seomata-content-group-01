		background: #f9fafb;
	}
	.locked-head {
		margin-bottom: 0.55rem;
	}
	.badge {
		display: inline-block;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent-dark);
		background: #e0e7ff;
		padding: 0.2rem 0.55rem;
		border-radius: 999px;
	}
	.locked-title {
		margin: 0.45rem 0 0;
		font-size: 1rem;
		font-weight: 800;
		color: var(--ink);
	}
	.locked-body,
	.locked-foot {
		margin: 0 0 0.5rem;
		font-size: 0.91rem;
