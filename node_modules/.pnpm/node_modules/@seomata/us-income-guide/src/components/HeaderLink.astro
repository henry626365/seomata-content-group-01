---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const rawHref = String(href ?? '/');
const hrefPath = rawHref.replace(/\/$/, '') || '/';

let isActive = false;
if (hrefPath === '/') {
	isActive = pathname === '/';
} else {
	isActive = pathname === hrefPath || pathname.startsWith(`${hrefPath}/`);
}
---

<a href={href} class:list={['nav-link', className, { active: isActive }]} {...props}>
	<slot />
</a>

<style>
	.nav-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.58rem 0.88rem;
		border-radius: 999px;
		font-size: 0.875rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		color: var(--ink-muted);
		text-decoration: none;
		background: transparent;
		border: 1px solid transparent;
		transition:
			color 0.18s ease,
			background-color 0.18s ease,
			border-color 0.18s ease,
			box-shadow 0.18s ease,
			font-weight 0.12s ease;
	}

	.nav-link:hover {
		color: var(--accent-dark);
		font-weight: 600;
		background: var(--accent-soft);
		border-color: rgba(37, 99, 235, 0.22);
		box-shadow: 0 1px 8px rgba(31, 41, 55, 0.06);
	}

	.nav-link.active {
		color: var(--accent-dark);
		font-weight: 700;
		background: linear-gradient(155deg, rgba(37, 99, 235, 0.16) 0%, rgba(37, 99, 235, 0.08) 100%);
		border-color: rgba(37, 99, 235, 0.35);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.55),
			0 2px 10px rgba(31, 41, 55, 0.08);
	}

	@media (prefers-reduced-motion: reduce) {
		.nav-link {
			transition: none;
		}
	}
</style>
