---
import { sites } from '@seomata/site-config';
import HeaderLink from './HeaderLink.astro';

const site = {
	...sites.massageGrowth,
	name: '按摩店增长指南',
	niche: '按摩店本地营销',
	description:
		'面向按摩店、按摩师和养生馆的 Google 地图、本地 SEO、客户评价和预约转化资源。'
};
---

<header>
	<nav>
		<h2><a href="/">{site.name}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/google-maps/">Google 地图</HeaderLink>
			<HeaderLink href="/reviews/">客户评价</HeaderLink>
			<HeaderLink href="/website-conversion/">网站转化</HeaderLink>
			<HeaderLink href="/massage-seo/">按摩 SEO</HeaderLink>
			<HeaderLink href="/templates/">模板</HeaderLink>
			<HeaderLink href="/about/">关于</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: clamp(0.85rem, 2.2vw, 1.15rem) 1rem clamp(0.75rem, 1.8vw, 1rem);
		background: linear-gradient(180deg, #eaf3fb 0%, #f4f9fc 45%, #fbfdff 100%);
		border-bottom: 1px solid rgba(209, 222, 234, 0.95);
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.85) inset,
			0 4px 18px rgba(11, 58, 83, 0.07);
	}
	h2 {
		margin: 0;
		font-size: 2.2rem;
		font-weight: 800;
		line-height: 1;
	}

	h2 a,
	h2 a.active {
		display: inline-flex;
		align-items: center;
		color: #2f80ed;
		text-shadow: 0 1px 0 rgba(255, 255, 255, 0.75), 0 0 10px rgba(47, 128, 237, 0.12);
		padding: 0.45rem 0;
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 1.35rem;
		justify-content: space-between;
		flex-wrap: nowrap;
		max-width: 960px;
		margin: 0 auto;
		padding: 0.55rem 0;
	}
	.internal-links {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.45rem;
	}
	@media (max-width: 720px) {
		h2 {
			font-size: 1.7rem;
		}
		nav {
			flex-direction: column;
			align-items: center;
			justify-content: center;
			flex-wrap: wrap;
		}
		.internal-links {
			justify-content: center;
		}
	}
</style>
