---
type Props = {
	title: string;
	description: string;
	href: string;
	badge?: string;
	image?: string;
	imageAlt?: string;
};

const { title, description, href, badge, image, imageAlt } = Astro.props;
---

<a class="resource-card" href={href}>
	{
		image && (
			<div class="media">
				<img src={image} alt={imageAlt ?? `${title} 配图`} loading="lazy" width="640" height="360" />
			</div>
		)
	}
	{badge && <span class="badge">{badge}</span>}
	<h3>{title}</h3>
	<p>{description}</p>
	<span class="link">打开资源</span>
</a>

<style>
	.resource-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.5rem;
		padding: 1.2rem 1.2rem 1.25rem;
		background: linear-gradient(155deg, #f5faff 0%, #ffffff 55%);
		border: 1px solid #cfe1ef;
		border-radius: 20px;
		text-decoration: none;
		color: inherit;
		min-height: 100%;
		box-shadow: 0 2px 10px rgba(11, 58, 83, 0.04);
		transition:
			border-color 0.2s ease,
			box-shadow 0.22s ease,
			transform 0.22s ease;
	}
	.resource-card:hover {
		border-color: #9ec4e8;
		box-shadow: 0 12px 32px rgba(11, 58, 83, 0.08);
		transform: translateY(-3px);
	}
	.media {
		margin: -1.2rem -1.2rem 0.2rem;
		width: calc(100% + 2.4rem);
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: linear-gradient(160deg, #eef5fb 0%, #e3f0fa 100%);
	}
	.media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 38%;
		display: block;
	}
	.badge {
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		color: #0b3a53;
		background: #e3f0fb;
		padding: 0.28rem 0.6rem;
		border-radius: 999px;
		border: 1px solid rgba(11, 58, 83, 0.06);
	}
	h3 {
		margin: 0;
		font-size: 1.02rem;
		color: #0b3a53;
		font-weight: 700;
		line-height: 1.35;
		letter-spacing: -0.02em;
	}
	p {
		margin: 0;
		font-size: 0.88rem;
		line-height: 1.55;
		color: #3d5f75;
		flex: 1;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.link {
		font-size: 0.82rem;
		font-weight: 700;
		color: #2f80ed;
		margin-top: auto;
		padding-top: 0.4rem;
	}
</style>
