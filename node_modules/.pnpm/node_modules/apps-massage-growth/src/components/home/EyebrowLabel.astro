---
type Props = {
	text: string;
	className?: string;
};

const { text, className = '' } = Astro.props;
---

<p class:list={['eyebrow-label', className]}>{text}</p>

<style>
	.eyebrow-label {
		margin: 0 0 0.65rem;
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #0b5a7a;
	}
</style>
