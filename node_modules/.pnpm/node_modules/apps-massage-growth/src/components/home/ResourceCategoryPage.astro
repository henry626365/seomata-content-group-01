---
import BaseHead from '../../components/BaseHead.astro';
import SiteFooter from '../../components/home/SiteFooter.astro';
import Header from '../../components/Header.astro';
import ArticleCard from '../../components/home/ArticleCard.astro';
import EyebrowLabel from '../../components/home/EyebrowLabel.astro';
import { getCollection } from 'astro:content';
import { nonBlogCardMap } from '../../data/nonBlogCardMap';

type ResourceCard = {
	title: string;
	description: string;
	href: string;
	linkLabel?: string;
	category?: string;
	image?: string;
	imageAlt?: string;
	imageFromPostId?: string;
};

type Props = {
	title: string;
	description: string;
	cards: ResourceCard[];
};

const { title, description, cards } = Astro.props;
const allBlogPosts = await getCollection('blog');
const postById = new Map(allBlogPosts.map((post) => [post.id, post]));
const categoryByPostId: Record<string, string> = {
	'massage-seo-checklist': 'SEO 专题',
	'google-business-profile-for-massage-therapists': '地图专题',
	'how-to-get-more-google-reviews-for-a-massage-clinic': '评价专题',
	'massage-website-conversion-guide': '转化专题',
	'massage-service-page-examples': '服务页专题',
	'massage-near-me-keyword-strategy': 'SEO 专题',
	'local-landing-pages-for-massage-clinics': '地图专题',
	'review-reply-templates-for-massage-businesses': '评价专题'
};

const getPostIdFromHref = (href: string) => href.match(/^\/blog\/([^/]+)\/?$/)?.[1];
const normalizeHref = (href: string) => (href.endsWith('/') ? href : `${href}/`);
const resolvedCards = cards.map((card) => {
	const postId = getPostIdFromHref(card.href);
	const post = postId ? postById.get(postId) : undefined;
	const nonBlogMeta = nonBlogCardMap[normalizeHref(card.href)];
	return {
		href: card.href,
		title: card.title ?? post?.data.title ?? '文章',
		description: card.description ?? post?.data.description ?? '',
		image:
			card.image ??
			(card.imageFromPostId ? postById.get(card.imageFromPostId)?.data.heroImage?.src : undefined) ??
			(nonBlogMeta?.imageFromPostId ? postById.get(nonBlogMeta.imageFromPostId)?.data.heroImage?.src : undefined) ??
			post?.data.heroImage?.src ??
			'/images/massage-local-search-system.svg',
		imageAlt: card.imageAlt ?? nonBlogMeta?.imageAlt ?? `《${card.title ?? post?.data.title ?? '文章'}》配图`,
		category: card.category ?? nonBlogMeta?.category ?? (postId ? categoryByPostId[postId] ?? '精选文章' : '资源')
	};
});
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body class="resource-body">
		<Header />
		<main class="resource-main">
			<section class="hero">
				<EyebrowLabel text="按摩店增长指南" className="hero-eyebrow" />
				<h1 class="hero-title">{title}</h1>
				<p class="hero-desc">{description}</p>
			</section>

			<section>
				<h2 class="section-title">相关资源</h2>
				<div class="card-grid">
					{
						resolvedCards.map((card) => (
							<ArticleCard
								href={card.href}
								title={card.title}
								description={card.description}
								image={card.image}
								imageAlt={card.imageAlt}
								category={card.category}
							/>
						))
					}
				</div>
			</section>
		</main>
		<SiteFooter />
	</body>
</html>

<style>
	:global(:root) {
		--massage-primary: #0b3a53;
		--massage-accent: #2f80ed;
		--massage-soft: #eef5fb;
	}

	.resource-body {
		margin: 0;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		background: linear-gradient(180deg, #f4f9fc 0%, #f0f4f7 35%, #ffffff 100%);
		color: #1c3a4d;
		overflow-x: clip;
	}

	.resource-main {
		flex: 1;
		width: min(1180px, calc(100% - clamp(1.5rem, 5vw, 3rem)));
		margin: 0 auto;
		padding: clamp(1.25rem, 3vw, 1.75rem) 0 clamp(2rem, 5vw, 3.25rem);
		display: grid;
		gap: clamp(2rem, 4.5vw, 2.75rem);
	}

	section {
		background: #fff;
		border: 1px solid rgba(209, 222, 234, 0.95);
		border-radius: 22px;
		padding: clamp(1.5rem, 3.5vw, 2.25rem) clamp(1.25rem, 3.5vw, 2rem);
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.8) inset,
			0 10px 40px rgba(11, 58, 83, 0.05);
	}

	.hero {
		background: #f4f9fc;
	}

	:global(.hero-eyebrow) {
		margin: 0 0 0.35rem;
		color: var(--massage-primary);
	}

	.hero-title {
		font-size: clamp(1.35rem, 2.6vw, 1.75rem);
		color: var(--massage-primary);
		margin: 0 0 0.55rem;
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.25;
	}

	.hero-desc {
		margin: 0;
		max-width: 52ch;
		font-size: clamp(0.95rem, 1.5vw, 1.02rem);
		line-height: 1.65;
		color: #3f6279;
	}

	.section-title {
		margin: 0 0 clamp(1.35rem, 3vw, 1.85rem);
		font-size: clamp(1.35rem, 2.6vw, 1.75rem);
		color: var(--massage-primary);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.25;
	}

	.card-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.15rem;
		align-items: stretch;
	}

	@media (max-width: 900px) {
		.card-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
