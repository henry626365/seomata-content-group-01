---
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} 按摩店增长指南。保留所有权利。</p>
	<div class="footer-links">
		<a href="/about">关于</a>
		<a href="/editorial-policy">编辑政策</a>
		<a href="/contact">联系我们</a>
	</div>
</footer>
<style>
	footer {
		padding: 2rem 1rem 4rem;
		background: #f5fafc;
		color: rgb(var(--gray-dark));
		text-align: center;
		border-top: 1px solid #d6e4ee;
	}
	footer p {
		margin: 0;
	}
	.footer-links {
		display: flex;
		justify-content: center;
		gap: 1.2rem;
		margin-top: 0.8rem;
		flex-wrap: wrap;
	}
	.footer-links a {
		text-decoration: none;
		color: #1f5f8c;
		font-weight: 600;
	}
	.footer-links a:hover {
		text-decoration: underline;
	}
</style>
