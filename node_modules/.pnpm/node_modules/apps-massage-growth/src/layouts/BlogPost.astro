---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import SiteFooter from '../components/home/SiteFooter.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, author = '按摩店增长指南编辑团队' } = Astro.props;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: min(960px, calc(100% - 2em));
				margin: 0 auto;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				width: 100%;
				height: auto;
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 100%;
				max-width: none;
				margin: 0 auto;
				padding: 1em 0;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1.25rem;
				padding: 1em 0;
				line-height: 1.2;
			}
			.title h1 {
				margin: 0 0 0.65rem 0;
			}
			.meta {
				margin: 0 0 0.75rem;
				padding: 0;
				list-style: none;
				color: rgb(var(--gray));
				display: grid;
				gap: 0.3rem;
				font-size: 0.95rem;
			}
			.meta strong {
				color: rgb(var(--gray-dark));
				font-weight: 700;
			}
			.toc {
				border: 1px solid #d2dfeb;
				border-radius: 12px;
				background: #f7fbff;
				padding: 1rem 1rem 0.9rem;
				margin: 0 0 1.2rem;
			}
			.toc h2 {
				margin: 0 0 0.45rem;
				font-size: 1rem;
				color: #0b3a53;
			}
			.toc p {
				margin: 0;
				color: #47677f;
				font-size: 0.92rem;
			}
			.related-reading {
				margin-top: 1.4rem;
				padding-top: 1rem;
				border-top: 1px solid #d2dfeb;
			}
			.related-reading h2 {
				margin: 0 0 0.6rem;
				font-size: 1.05rem;
				color: #0b3a53;
			}
			.related-reading ul {
				margin: 0;
				padding-left: 1.15rem;
			}
			.related-reading a {
				color: #2f80ed;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article id="article-top">
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt={`${title} 文章主图`} />}
				</div>
				<div class="prose">
					<div class="title">
						<ul class="meta">
							<li><strong>作者：</strong>{author}</li>
							<li>
								<strong>Published：</strong>
								<FormattedDate date={pubDate} />
							</li>
							{
								updatedDate && (
									<li>
										<strong>Updated：</strong>
										<FormattedDate date={updatedDate} />
									</li>
								)
							}
						</ul>
						<h1>{title}</h1>
						<hr />
					</div>
					<section class="toc" aria-labelledby="toc-title">
						<h2 id="toc-title">文章目录</h2>
						<p>目录区域已预留，后续可按正文标题自动生成锚点导航。</p>
					</section>
					<slot />
					<section class="related-reading" id="extended-reading" aria-labelledby="related-reading-title">
						<h2 id="related-reading-title">延伸阅读</h2>
						<ul>
							<li><a href="/blog/">浏览全部按摩增长指南</a></li>
							<li><a href="/google-maps/">Google 地图专题</a></li>
							<li><a href="/reviews/">客户评价专题</a></li>
						</ul>
					</section>
				</div>
			</article>
		</main>
		<SiteFooter />
	</body>
</html>
