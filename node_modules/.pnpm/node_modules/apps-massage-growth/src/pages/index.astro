---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import SiteFooter from '../components/home/SiteFooter.astro';
import HomeHero from '../components/home/HomeHero.astro';
import SectionHeader from '../components/home/SectionHeader.astro';
import FeaturedArticleGrid from '../components/home/FeaturedArticleGrid.astro';
import ArticleCard from '../components/home/ArticleCard.astro';
import CollectionGrid from '../components/home/CollectionGrid.astro';
import ResourceCard from '../components/home/ResourceCard.astro';

const allBlogPosts = await getCollection('blog');
const postById = new Map(allBlogPosts.map((post) => [post.id, post]));
const getCardImage = (href: string, fallback: string) => {
	const match = href.match(/^\/blog\/([^/]+)\/?$/);
	if (!match) return fallback;
	return postById.get(match[1])?.data.heroImage?.src ?? fallback;
};
const getPostImage = (postId: string, fallback: string) => postById.get(postId)?.data.heroImage?.src ?? fallback;

const categoryByPostId: Record<string, string> = {
	'massage-seo-checklist': 'SEO 专题',
	'google-business-profile-for-massage-therapists': '地图专题',
	'how-to-get-more-google-reviews-for-a-massage-clinic': '评价专题',
	'massage-website-conversion-guide': '转化专题',
	'massage-service-page-examples': '服务页专题',
	'massage-near-me-keyword-strategy': 'SEO 专题',
	'local-landing-pages-for-massage-clinics': '地图专题',
	'review-reply-templates-for-massage-businesses': '评价专题'
};

const featured = {
	href: '/blog/massage-seo-checklist/',
	title: '按摩店本地 SEO 检查清单',
	description:
		'从 Google Business Profile、服务页面、评价、预约按钮和本地内容结构开始，系统检查按摩店的线上曝光基础。',
	image: getCardImage('/blog/massage-seo-checklist/', '/images/massage-seo-checklist-preview.svg'),
	imageAlt: '按摩店本地 SEO 检查清单预览，包含资料页、服务页、评价、预约与本地内容项',
	category: 'SEO 专题'
};

const featuredSide = [
	{
		href: '/blog/google-business-profile-for-massage-therapists/',
		title: 'Google Business Profile 优化指南',
		description: '核对类目、服务项、照片节奏与公开信息一致性，让资料页承接本地搜索意图。',
		image: getCardImage('/blog/google-business-profile-for-massage-therapists/', '/images/massage-google-maps-visibility.svg'),
		imageAlt: '本地搜索曝光、地图结果、评价信任与预约入口示意图',
		category: '地图专题'
	},
	{
		href: '/blog/how-to-get-more-google-reviews-for-a-massage-clinic/',
		title: '按摩店如何获得更多 Google 评价',
		description: '把邀评做成可重复的前台动作：时机、话术边界与合规提醒。',
		image: getCardImage('/blog/how-to-get-more-google-reviews-for-a-massage-clinic/', '/images/massage-review-request-flow.svg'),
		imageAlt: '完成服务、发送评价请求、获得 Google 评价与店主回复流程图',
		category: '评价专题'
	},
	{
		href: '/blog/massage-website-conversion-guide/',
		title: '按摩店网站预约转化指南',
		description: '从首屏信息、移动端操作路径到预约按钮位置，减少中途流失。',
		image: getCardImage('/blog/massage-website-conversion-guide/', '/images/massage-local-search-system.svg'),
		imageAlt: '搜索、Google 地图、访问网站到完成预约的流程示意图',
		category: '转化专题'
	},
	{
		href: '/blog/massage-service-page-examples/',
		title: '更容易促成预约的按摩服务页面应该怎么写',
		description: '用清晰结构呈现适合人群、时长价格与预约入口，降低决策犹豫。',
		image: getCardImage('/blog/massage-service-page-examples/', '/images/massage-service-page-wireframe.svg'),
		imageAlt: '按摩服务页面线框：服务名称、适合人群、时长与价格、评价、预约与 FAQ',
		category: '服务页专题'
	}
];

const mapCards = [
	{
		href: '/blog/google-business-profile-for-massage-therapists/',
		title: '按摩师与按摩店的 Google Business Profile 优化指南',
		description: '梳理资料页信息架构与本地相关性基础，避免因类目或信息不一致错过曝光。',
		image: getCardImage('/blog/google-business-profile-for-massage-therapists/', '/images/massage-google-maps-visibility.svg'),
		imageAlt: '本地搜索曝光、地图结果、评价信任与预约入口教育示意图',
		category: '地图专题'
	},
	{
		href: '/blog/massage-near-me-keyword-strategy/',
		title: '按摩店如何布局「Massage Near Me」类关键词',
		description: '把泛意图词拆到服务与城市语境里，避免内容彼此抢位、语意不清。',
		image: getCardImage('/blog/massage-near-me-keyword-strategy/', '/images/massage-seo-checklist-preview.svg'),
		imageAlt: 'SEO 检查清单式结构示意，用于内容规划参考',
		category: 'SEO 专题'
	},
	{
		href: '/blog/local-landing-pages-for-massage-clinics/',
		title: '按摩店本地落地页建设指南',
		description: '为「城市 + 服务」落地页补齐要素：意图对应、信任块与预约路径。',
		image: getCardImage('/blog/local-landing-pages-for-massage-clinics/', '/images/massage-local-search-system.svg'),
		imageAlt: '从搜索到预约转化的流程示意图',
		category: '地图专题'
	}
];

const reviewCards = [
	{
		href: '/blog/how-to-get-more-google-reviews-for-a-massage-clinic/',
		title: '按摩店如何获得更多 Google 评价',
		description: '把邀评融入服务收尾节奏，并注意合规与体验边界。',
		image: getCardImage('/blog/how-to-get-more-google-reviews-for-a-massage-clinic/', '/images/massage-review-request-flow.svg'),
		imageAlt: '评价请求与回复流程示意图',
		category: '评价专题'
	},
	{
		href: '/blog/review-reply-templates-for-massage-businesses/',
		title: '按摩店 Google 评价回复模板',
		description: '面向好评、中评与差评的公开回复思路，突出专业与可核实信息。',
		image: getCardImage('/blog/review-reply-templates-for-massage-businesses/', '/images/massage-review-request-flow.svg'),
		imageAlt: '评价与公开回复环节示意图',
		category: '评价专题'
	},
	{
		href: '/templates/',
		title: '评价请求短信模板',
		description: '到店后跟进的短信话术与节奏示例，可按门店语气微调。',
		image: '/images/massage-review-request-flow.svg',
		imageAlt: '评价请求与跟进流程示意图',
		category: '模板资源'
	}
];

const conversionCards = [
	{
		href: '/blog/massage-website-conversion-guide/',
		title: '按摩店网站预约转化指南',
		description: '聚焦移动端路径、预约按钮与首屏信息是否回答了客户真正的问题。',
		image: getCardImage('/blog/massage-website-conversion-guide/', '/images/massage-local-search-system.svg'),
		imageAlt: '访问网站并完成预约的转化流程',
		category: '转化专题'
	},
	{
		href: '/blog/massage-service-page-examples/',
		title: '更容易促成预约的按摩服务页面应该怎么写',
		description: '用线框级结构检查：适合人群、时长价格、评价与 FAQ 是否到位。',
		image: getCardImage('/blog/massage-service-page-examples/', '/images/massage-service-page-wireframe.svg'),
		imageAlt: '按摩服务页面结构线框示意',
		category: '服务页专题'
	},
	{
		href: '/templates/',
		title: '按摩服务页面结构模板',
		description: '可直接套用的段落顺序与要点清单，便于前台与外包对齐。',
		image: '/images/massage-service-page-wireframe.svg',
		imageAlt: '服务页面模块结构示意',
		category: '模板资源'
	}
];

const collectionItems = [
	{
		title: 'Google 地图优化专题',
		description: '资料页、类目、照片节奏、服务项与本地相关性，一起梳理地图侧基础。',
		href: '/google-maps/',
		image: getPostImage('google-business-profile-for-massage-therapists', '/images/massage-google-maps-visibility.svg'),
		imageAlt: '本地曝光与地图环节教育示意图'
	},
	{
		title: '评价与口碑专题',
		description: '邀评流程、公开回复与常见情境话术，让评价成为持续运营动作。',
		href: '/reviews/',
		image: getPostImage('how-to-get-more-google-reviews-for-a-massage-clinic', '/images/massage-review-request-flow.svg'),
		imageAlt: '评价请求与回复流程示意图'
	},
	{
		title: '按摩服务页面专题',
		description: '面向转化与本地 SEO 的服务页结构与示例，减少「看了网页仍不预约」。',
		href: '/website-conversion/',
		image: getPostImage('massage-service-page-examples', '/images/massage-service-page-wireframe.svg'),
		imageAlt: '按摩服务页面线框结构'
	},
	{
		title: '本地 SEO 基础专题',
		description: '清单式检查：内容意图、落地页、评价与预约是否形成闭环。',
		href: '/massage-seo/',
		image: getPostImage('massage-seo-checklist', '/images/massage-seo-checklist-preview.svg'),
		imageAlt: '按摩店 SEO 检查清单预览'
	}
];

const templateResources = [
	{
		title: '按摩 SEO 检查清单',
		description: '按月复盘资料页、服务页、评价、预约入口与本地内容是否一致。',
		href: '/blog/massage-seo-checklist/',
		badge: '清单',
		image: getPostImage('massage-seo-checklist', '/images/massage-seo-checklist-preview.svg'),
		imageAlt: '按摩 SEO 检查清单主图'
	},
	{
		title: '评价请求短信模板',
		description: '短信邀评示例话术，可与前台流程结合，注意频率与合规。',
		href: '/templates/',
		badge: '模板',
		image: getPostImage('massage-clinic-review-request-sms-templates', '/images/massage-review-request-flow.svg'),
		imageAlt: '评价请求短信模板示意主图'
	},
	{
		title: '按摩服务页面结构模板',
		description: '段落顺序与必备模块，用来对齐撰稿、设计与 SEO 需求。',
		href: '/blog/massage-service-page-examples/',
		badge: '模板',
		image: getPostImage('massage-service-page-examples', '/images/massage-service-page-wireframe.svg'),
		imageAlt: '按摩服务页面结构模板主图'
	},
	{
		title: '按摩行业本地搜索可见度报告',
		description: '方法透明的行业观察框架，帮助门店判断当前处于基础、稳定还是进阶阶段。',
		href: '/reports/massage-local-search-visibility-report/',
		badge: '报告',
		image: getPostImage('massage-near-me-keyword-strategy', '/images/massage-google-maps-visibility.svg'),
		imageAlt: '本地搜索可见度报告示意主图'
	}
];

const breakdownCards = [
	{
		href: '/blog/massage-website-conversion-guide/',
		title: '一个按摩店网站为什么有访问却没有预约',
		description: '从设备体验、首屏信息与预约路径拆解常见流失点，不涉及任何个案数据。',
		image: getCardImage('/blog/massage-website-conversion-guide/', '/images/massage-local-search-system.svg'),
		imageAlt: '从访问到预约的环节拆解示意',
		category: '营销拆解'
	},
	{
		href: '/blog/massage-service-page-examples/',
		title: '一个服务页面应该如何降低预约犹豫',
		description: '用结构与文案层次回应「是否适合我、要多少钱、怎么约」三类问题。',
		image: getCardImage('/blog/massage-service-page-examples/', '/images/massage-service-page-wireframe.svg'),
		imageAlt: '服务页面模块拆解示意',
		category: '营销拆解'
	},
	{
		href: '/blog/google-business-profile-for-massage-therapists/',
		title: 'Google 地图曝光不足时先检查什么',
		description: '优先核对类目、服务项、营业信息与照片是否传递一致的专业信号。',
		image: getCardImage('/blog/google-business-profile-for-massage-therapists/', '/images/massage-google-maps-visibility.svg'),
		imageAlt: '地图曝光相关环节示意图',
		category: '营销拆解'
	}
];

const latestPosts = allBlogPosts
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title="按摩店增长指南｜Google 地图、本地 SEO 与预约增长资源"
			description="学习如何通过 Google 地图、本地 SEO、客户评价、服务页面和预约转化优化，帮助按摩店获得更多本地客户。"
		/>
	</head>
	<body class="home-body">
		<Header />
		<main class="home-main">
			<HomeHero
				title="帮助按摩店通过 Google 地图和本地搜索获得更多预约"
				subtitle="面向按摩店、按摩师和养生馆的实用增长资源，覆盖 Google Business Profile、本地 SEO、客户评价、服务页面和预约转化。"
				primaryLabel="查看按摩 SEO 检查清单"
				primaryHref="/blog/massage-seo-checklist/"
				secondaryLabel="学习 Google 地图优化"
				secondaryHref="/blog/google-business-profile-for-massage-therapists/"
			/>

			<section class="panel" aria-labelledby="featured-title">
				<SectionHeader
					headingId="featured-title"
					title="精选指南"
					description="从清单到实操页面，优先补齐本地曝光、评价与预约路径上的关键模块。"
				/>
				<FeaturedArticleGrid featured={featured} items={featuredSide} />
			</section>

			<section class="panel">
				<SectionHeader
					title="Google 地图曝光"
					description="学习如何优化 Google Business Profile、服务项目、照片、评价和本地相关性，让附近客户更容易发现你的按摩店。"
				/>
				<div class="card-row-3">
					{mapCards.map((c) => <ArticleCard {...c} />)}
				</div>
			</section>

			<section class="panel">
				<SectionHeader
					title="客户评价与口碑"
					description="建立评价请求、评价回复和口碑管理流程，让新客户在预约前更信任你的按摩服务。"
				/>
				<div class="card-row-3">
					{reviewCards.map((c) => <ArticleCard {...c} />)}
				</div>
			</section>

			<section class="panel">
				<SectionHeader
					title="网站与预约转化"
					description="优化服务介绍、价格信息、预约按钮和移动端体验，把网站访问者转化为真实预约。"
				/>
				<div class="card-row-3">
					{conversionCards.map((c) => <ArticleCard {...c} />)}
				</div>
			</section>

			<section class="panel">
				<SectionHeader
					title="热门专题"
					description="按主题聚合地图、评价、服务页与本地 SEO 基础，便于系统阅读。"
				/>
				<CollectionGrid items={collectionItems} />
			</section>

			<section class="panel">
				<SectionHeader title="实用模板与清单" description="即用型结构、话术与清单，适合门店直接执行或微调。" />
				<div class="resource-row">
					{templateResources.map((r) => <ResourceCard {...r} />)}
				</div>
			</section>

			<section class="panel">
				<SectionHeader
					title="按摩营销拆解"
					description="通过教育型拆解，分析按摩店网站、Google 地图和预约流程中常见的优化机会。不展示个案例数据或排名截图。"
				/>
				<div class="card-row-3">
					{breakdownCards.map((c) => <ArticleCard {...c} />)}
				</div>
			</section>

			<section class="panel">
				<SectionHeader title="最新指南" description="围绕本地曝光、评价与预约转化的最新更新内容。" />
				<div class="card-row-3 latest">
					{
						latestPosts.map((post) => (
							<ArticleCard
								href={`/blog/${post.id}/`}
								title={post.data.title}
								description={post.data.description}
								image={post.data.heroImage?.src ?? '/images/massage-local-search-system.svg'}
								imageAlt={`《${post.data.title}》配图示意`}
								category={categoryByPostId[post.id] ?? '指南'}
							/>
						))
					}
				</div>
				<p class="more-link">
					<a href="/blog/">浏览全部指南</a>
				</p>
			</section>
		</main>
		<SiteFooter />
	</body>
</html>

<style>
	:global(:root) {
		--massage-primary: #0b3a53;
		--massage-accent: #2f80ed;
		--massage-soft: #eef5fb;
		--massage-border: #d1deea;
	}
	.home-body {
		margin: 0;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		background: linear-gradient(180deg, #f4f9fc 0%, #f0f4f7 35%, #ffffff 100%);
		color: #1c3a4d;
		overflow-x: clip;
	}
	.home-main {
		flex: 1;
		width: min(1180px, calc(100% - clamp(1.5rem, 5vw, 3rem)));
		margin: 0 auto;
		padding: clamp(1.25rem, 3vw, 1.75rem) 0 clamp(2rem, 5vw, 3.25rem);
		display: flex;
		flex-direction: column;
		gap: clamp(2rem, 4.5vw, 2.75rem);
	}
	.panel {
		background: #fff;
		border: 1px solid rgba(209, 222, 234, 0.95);
		border-radius: 22px;
		padding: clamp(1.5rem, 3.5vw, 2.25rem) clamp(1.25rem, 3.5vw, 2rem);
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.8) inset,
			0 10px 40px rgba(11, 58, 83, 0.05);
	}
	.card-row-3 {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.15rem;
		align-items: stretch;
	}
	.card-row-3.latest {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}
	.latest {
		row-gap: 1rem;
	}
	@media (max-width: 900px) {
		.card-row-3,
		.card-row-3.latest {
			grid-template-columns: 1fr;
		}
	}
	.resource-row {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.9rem;
	}
	@media (max-width: 1080px) {
		.resource-row {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 800px) {
		.resource-row {
			grid-template-columns: 1fr;
		}
	}
	.more-link {
		margin: 1.35rem 0 0;
		text-align: right;
		padding-top: 0.25rem;
	}
	.more-link a {
		font-weight: 600;
		color: var(--massage-accent);
		text-decoration: none;
	}
	.more-link a:hover {
		text-decoration: underline;
	}
</style>
