---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="About Massage Business Growth"
			description="About Massage Business Growth and how this local marketing resource site serves massage businesses."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<h1>About Massage Business Growth</h1>
				<p>
					Massage Business Growth is a local marketing resource center for massage clinics, independent massage
					therapists, and wellness studios in the U.S.
				</p>
				<p>
					We focus on practical topics across Google Maps visibility, reviews and reputation management, website
					and booking conversion, and massage SEO execution.
				</p>
				<p>
					The goal is simple: help local massage businesses make better online marketing decisions with clearer
					workflows, templates, and educational breakdowns.
				</p>
				<p>
					We do not claim fake team scale, fake client counts, or fabricated performance outcomes. Content is
					published to educate and support better decision-making, not to overstate results.
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	section {
		background: #fff;
		border: 1px solid #d2dfeb;
		border-radius: 14px;
		padding: 1.6rem;
	}
	h1 {
		color: #0b3a53;
	}
</style>
